//--------------------------------------------------------------------------------------------------
// Trigger: Randomize Propaganda
//--------------------------------------------------------------------------------------------------
bool gt_RandomizePropaganda_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((RandomInt(1, 4) == 1) && (UnitGetOwner(gv_terra) == gv_itemHighlord) && (PlayerType(gv_itemHighlord) == c_playerTypeComputer)) {
        UnitIssueOrder(gv_terra, Order(AbilityCommand("PropagandaAgainstTheTau", 0)), c_orderQueueAddToEnd);
    }

    if ((RandomInt(1, 4) == 1) && (UnitGetOwner(gv_terra) == gv_itemHighlord) && (PlayerType(gv_itemHighlord) == c_playerTypeComputer)) {
        UnitIssueOrder(gv_terra, Order(AbilityCommand("PropagandaAgainstTheNecrons", 0)), c_orderQueueAddToEnd);
    }

    if ((RandomInt(1, 4) == 1) && (UnitGetOwner(gv_inwit) == gv_itemLion) && (PlayerType(gv_itemLion) == c_playerTypeComputer)) {
        UnitIssueOrder(gv_inwit, Order(AbilityCommand("PropagandaAgainstTheTau", 0)), c_orderQueueAddToEnd);
    }

    if ((RandomInt(1, 4) == 1) && (UnitGetOwner(gv_inwit) == gv_itemLion) && (PlayerType(gv_itemLion) == c_playerTypeComputer)) {
        UnitIssueOrder(gv_inwit, Order(AbilityCommand("PropagandaAgainstTheNecrons", 0)), c_orderQueueAddToEnd);
    }

    if ((RandomInt(1, 4) == 1) && (UnitGetOwner(gv_macragge) == gv_itemRoboute) && (PlayerType(gv_itemRoboute) == c_playerTypeComputer)) {
        UnitIssueOrder(gv_macragge, Order(AbilityCommand("PropagandaAgainstTheTau", 0)), c_orderQueueAddToEnd);
    }

    if ((RandomInt(1, 4) == 1) && (UnitGetOwner(gv_macragge) == gv_itemRoboute) && (PlayerType(gv_itemRoboute) == c_playerTypeComputer)) {
        UnitIssueOrder(gv_macragge, Order(AbilityCommand("PropagandaAgainstTheNecrons", 0)), c_orderQueueAddToEnd);
    }

    return true;
}

