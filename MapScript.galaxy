bool gt_MagnusTheRedDeath_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    if ((UnitGetType(libNtve_gf_KillingUnit()) == "RaynorLab")) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/0973274A"));
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "AlarakChampion", 0, UnitGetOwner(libNtve_gf_KillingUnit()), UnitGetPosition(libNtve_gf_KillingUnit()));
    }
    else if ((UnitGetType(libNtve_gf_KillingUnit()) == "LionElJonsson")) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/8B3920CD"));
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "AlarakChampion", 0, UnitGetOwner(libNtve_gf_KillingUnit()), UnitGetPosition(libNtve_gf_KillingUnit()));
    }
    else if (true) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/607D3E3C"));
    }
    return true;
}

