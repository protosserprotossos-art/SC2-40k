//--------------------------------------------------------------------------------------------------
bool gt_StartAIResearch_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetUpgradeLevelForPlayer(gv_itemTau, "AIResearchStarted", 1);
    UIDisplayMessage(PlayerGroupSingle(gv_itemTau), c_messageAreaSubtitle, StringExternal("Param/Value/A0E1B84A"));
    gf_LoyaltyTauImperium(20, false);
    Wait(300.0, c_timeGame);
    TriggerExecute(gt_AIResearchTier1, true, false);
    Wait(300.0, c_timeGame);
    TriggerExecute(gt_AIResearchTier2, true, false);
    Wait(300.0, c_timeGame);
    TriggerExecute(gt_AIResearchTier3, true, false);
    Wait(300.0, c_timeGame);
    TriggerExecute(gt_AIResearchTier4, true, false);
    Wait(480.0, c_timeGame);
    TriggerExecute(gt_AIResearchCollapseRevolt, true, false);
    return true;
}

