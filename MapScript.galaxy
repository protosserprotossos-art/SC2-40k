    gt_ChangeAllianceWar = TriggerCreate("gt_ChangeAllianceWar_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: UI Update
//--------------------------------------------------------------------------------------------------
bool gt_UIUpdate_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_disableUIBoolean == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(gt_UnityUIHighlords, true, false);
    TriggerExecute(gt_UnityUILion, true, false);
    TriggerExecute(gt_UnityUIRoboute, true, false);
    TriggerExecute(gt_GreaterGoodUITau, true, false);
    TriggerExecute(gt_DynastyUINecrons, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_UIUpdate_Init () {
    gt_UIUpdate = TriggerCreate("gt_UIUpdate_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Change loyalty (Time)
//--------------------------------------------------------------------------------------------------
bool gt_ChangeloyaltyTime_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((RandomInt(1, 2) == 1)) {
        gf_RandomizeLoyalty(5);
    }
    else if ((RandomInt(1, 2) == 1)) {
        gf_RandomizeLoyalty(4);
    }
    else if (true) {
        gf_RandomizeLoyalty(3);
    }
    return true;
}

