//--------------------------------------------------------------------------------------------------
// Trigger: Defense Select
//--------------------------------------------------------------------------------------------------
bool gt_DefenseSelect_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unitgroup lv_tempGroup;

    // Automatic Variable Declarations
    unitgroup auto43101260_g;
    int auto43101260_u;
    unit auto43101260_var;
    string auto48354625_val;

    // Variable Initialization
    lv_tempGroup = UnitGroupEmpty();

    // Conditions
    if (testConds) {
        if (!((gv_recentlyDSD[EventPlayer()] == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_recentlyDSD[EventPlayer()] = true;
    UnitClearSelection(EventPlayer());
    auto43101260_g = UnitGroupAlliance(EventPlayer(), c_unitAllianceAlly, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto43101260_u = UnitGroupCount(auto43101260_g, c_unitCountAll);
    for (;; auto43101260_u -= 1) {
        auto43101260_var = UnitGroupUnitFromEnd(auto43101260_g, auto43101260_u);
        if (auto43101260_var == null) { break; }
        if ((UnitGetOwner(auto43101260_var) == EventPlayer())) {
            auto48354625_val = UnitGetType(auto43101260_var);
            if (auto48354625_val == "MannedTurret") {
                UnitGroupAdd(lv_tempGroup, auto43101260_var);
            }
            else if (auto48354625_val == "AutoTurret") {
                UnitGroupAdd(lv_tempGroup, auto43101260_var);
            }
            else if (auto48354625_val == "MissileTurret") {
                UnitGroupAdd(lv_tempGroup, auto43101260_var);
            }
            else if (auto48354625_val == "PhotonCannon") {
                UnitGroupAdd(lv_tempGroup, auto43101260_var);
            }
            else if (auto48354625_val == "NecronFortificaiton") {
                UnitGroupAdd(lv_tempGroup, auto43101260_var);
            }
            else if (auto48354625_val == "KhaydarinMonolith") {
                UnitGroupAdd(lv_tempGroup, auto43101260_var);
            }
            else if (auto48354625_val == "SporeCrawler") {
                UnitGroupAdd(lv_tempGroup, auto43101260_var);
            }
            else if (auto48354625_val == "SpineCrawler") {
                UnitGroupAdd(lv_tempGroup, auto43101260_var);
            }
            else if (auto48354625_val == "KorhalSporeCannon") {
                UnitGroupAdd(lv_tempGroup, auto43101260_var);
            }
            else if (auto48354625_val == "PrimalSunkenColony") {
                UnitGroupAdd(lv_tempGroup, auto43101260_var);
            }
            else if (auto48354625_val == "AshWorm") {
                UnitGroupAdd(lv_tempGroup, auto43101260_var);
            }
            else {
            }
        }

    }
    UnitGroupSelect(lv_tempGroup, EventPlayer(), true);
    Wait(3.0, c_timeGame);
    gv_recentlyDSD[EventPlayer()] = false;
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_DefenseSelect_Init () {
    gt_DefenseSelect = TriggerCreate("gt_DefenseSelect_Func");
    TriggerAddEventChatMessage(gt_DefenseSelect, c_playerAny, "-ds", true);
}

