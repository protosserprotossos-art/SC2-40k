    DialogCreate(200, 70, c_anchorBottomRight, 235, 265, false);
    gv_dialogAllyOpen2 = DialogLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_dialogAllyOpen2, 180, 50, c_anchorBottomRight, 10, 8, StringExternal("Param/Value/12CFCF25"), StringExternal("Param/Value/9EBA4E8C"), "");
    gv_dialogAllyOpenItem2 = DialogControlLastCreated();
    DialogSetVisible(DialogLastCreated(), PlayerGroupAll(), true);
    TriggerExecute(gt_SetupAchievements, true, false);
    return true;
}

