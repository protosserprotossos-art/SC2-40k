//--------------------------------------------------------------------------------------------------
bool gt_UpgradeCompletedstoring_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    gv_indexvaluesfilled += 1;
    gv_upgradeName[gv_indexvaluesfilled] = (EventUpgradeName());
    gv_upgradeLevel[gv_indexvaluesfilled] = TechTreeUpgradeCount(EventPlayer(), EventUpgradeName(), c_techCountCompleteOnly);
    gv_player[gf_GetPlayerItemValue(EventPlayer())] = gf_GetPlayerItemValue(EventPlayer());
    return true;
}

