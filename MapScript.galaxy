//--------------------------------------------------------------------------------------------------
// Trigger: Defeat cons
//--------------------------------------------------------------------------------------------------
bool gt_Defeatcons_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto2B80B49D_g;
    int auto2B80B49D_u;
    unit auto2B80B49D_var;
    unitgroup auto036D30EC_g;
    int auto036D30EC_u;
    unit auto036D30EC_var;
    unitgroup autoAD009C6D_g;
    int autoAD009C6D_u;
    unit autoAD009C6D_var;

    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_highlordsDefeated == false) && ((UnitGroupCount(gv_highlordsStructures, c_unitCountAll) <= 0) || (UnitIsAlive(UnitFromId(1023264517)) == false))) {
        Wait(5.0, c_timeGame);
        gv_highlordsDefeated = true;
        auto2B80B49D_g = UnitGroup(null, gv_itemHighlord, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        auto2B80B49D_u = UnitGroupCount(auto2B80B49D_g, c_unitCountAll);
        for (;; auto2B80B49D_u -= 1) {
            auto2B80B49D_var = UnitGroupUnitFromEnd(auto2B80B49D_g, auto2B80B49D_u);
            if (auto2B80B49D_var == null) { break; }
            libNtve_gf_RescueUnit(auto2B80B49D_var, gv_itemWarringStates, true);
        }
        Wait(5.0, c_timeGame);
        TriggerExecute(gt_PlayerleavesAllianceaspecthandler, true, false);
        gf_TurnPlayerIntoSpectator(gv_itemHighlord);
        TriggerExecute(gt_Wincons, true, false);
        gv_highlordsAIActive = false;
    }

    if ((gv_lionDefeated == false) && ((UnitGroupCount(gv_lionStructures, c_unitCountAll) <= 0) || (UnitIsAlive(UnitFromId(1023264517)) == false))) {
        Wait(5.0, c_timeGame);
        gv_lionDefeated = true;
        auto036D30EC_g = UnitGroup(null, gv_itemLion, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        auto036D30EC_u = UnitGroupCount(auto036D30EC_g, c_unitCountAll);
        for (;; auto036D30EC_u -= 1) {
            auto036D30EC_var = UnitGroupUnitFromEnd(auto036D30EC_g, auto036D30EC_u);
            if (auto036D30EC_var == null) { break; }
            libNtve_gf_RescueUnit(auto036D30EC_var, gv_itemWarringStates, true);
        }
        Wait(5.0, c_timeGame);
        TriggerExecute(gt_PlayerleavesAllianceaspecthandler, true, false);
        gf_TurnPlayerIntoSpectator(gv_itemLion);
        TriggerExecute(gt_Wincons, true, false);
        gv_lionAIActive = false;
    }

    if ((gv_robouteDefeated == false) && ((UnitGroupCount(gv_robouteStructures, c_unitCountAll) <= 0) || (UnitIsAlive(UnitFromId(1023264517)) == false))) {
        Wait(5.0, c_timeGame);
        gv_robouteDefeated = true;
        autoAD009C6D_g = UnitGroup(null, gv_itemRoboute, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        autoAD009C6D_u = UnitGroupCount(autoAD009C6D_g, c_unitCountAll);
        for (;; autoAD009C6D_u -= 1) {
            autoAD009C6D_var = UnitGroupUnitFromEnd(autoAD009C6D_g, autoAD009C6D_u);
            if (autoAD009C6D_var == null) { break; }
            libNtve_gf_RescueUnit(autoAD009C6D_var, gv_itemWarringStates, true);
        }
        Wait(5.0, c_timeGame);
        TriggerExecute(gt_PlayerleavesAllianceaspecthandler, true, false);
        gf_TurnPlayerIntoSpectator(gv_itemRoboute);
        TriggerExecute(gt_Wincons, true, false);
        gv_robouteAIActive = false;
    }

    if ((gv_tauDefeated == false) && (UnitGroupCount(gv_tauStructures, c_unitCountAll) <= 0)) {
        Wait(5.0, c_timeGame);
        gv_tauDefeated = true;
        TriggerExecute(gt_PlayerleavesAllianceaspecthandler, true, false);
        gf_TurnPlayerIntoSpectator(gv_itemTau);
        TriggerExecute(gt_Wincons, true, false);
        gv_tauAIActive = false;
    }

    if ((gv_necronDefeated == false) && (UnitGroupCount(gv_necronStructures, c_unitCountAll) <= 0) && (((gv_trazynGotten == true) && (gv_imotekhGotten == true)) || (gv_necrontryingtosoftlock == true))) {
        Wait(5.0, c_timeGame);
        gv_necronDefeated = true;
        TriggerExecute(gt_PlayerleavesAllianceaspecthandler, true, false);
        gf_TurnPlayerIntoSpectator(gv_itemNecrons);
        TriggerExecute(gt_Wincons, true, false);
        gv_necronsAIActive = false;
    }

    if ((gv_leviathanDefeated == false) && (UnitGroupCount(gv_leviathanStructures, c_unitCountAll) <= 0)) {
        Wait(5.0, c_timeGame);
        gv_leviathanDefeated = true;
