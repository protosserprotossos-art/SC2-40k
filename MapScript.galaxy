    }

    TriggerExecute(gt_Defeatcons, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_TombWorldDeaths_Init () {
    gt_TombWorldDeaths = TriggerCreate("gt_TombWorldDeaths_Func");
    TriggerAddEventUnitDied(gt_TombWorldDeaths, UnitRefFromVariable("gv_tombWorldAthonos"));
    TriggerAddEventUnitDied(gt_TombWorldDeaths, UnitRefFromVariable("gv_tombWorldCanta"));
    TriggerAddEventUnitDied(gt_TombWorldDeaths, UnitRefFromVariable("gv_tombWorldFalShia"));
    TriggerAddEventUnitDied(gt_TombWorldDeaths, UnitRefFromVariable("gv_tombWorldIce"));
}

//--------------------------------------------------------------------------------------------------
// Trigger: Tomb World Death
//--------------------------------------------------------------------------------------------------
bool gt_TombWorldDeath_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(gt_Defeatcons, true, false);
    if (((UnitGetOwner(libNtve_gf_KillingUnit()) == gv_itemHighlord) || (UnitGetOwner(libNtve_gf_KillingUnit()) == gv_itemLion) || (UnitGetOwner(libNtve_gf_KillingUnit()) == gv_itemRoboute) || (UnitGetOwner(libNtve_gf_KillingUnit()) == gv_itemTau))) {
        RegionSetCenter(RegionFromId(46), UnitGetPosition(libNtve_gf_KillingUnit()));
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "ScavengeNecronTechnology", 0, 0, UnitGetPosition(libNtve_gf_KillingUnit()));
        gv_scavengeNecronTechnologyBeacon = UnitLastCreated();
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/CBC3951A"));
        TriggerExecute(gt_Defeatcons, true, false);
        Wait(10.0, c_timeGame);
        if ((UnitGetOwner(libNtve_gf_KillingUnit()) == gv_itemHighlord)) {
            gv_killerOfTombWorld = gv_itemHighlord;
        }

        if ((UnitGetOwner(libNtve_gf_KillingUnit()) == gv_itemLion)) {
            gv_killerOfTombWorld = gv_itemLion;
        }

        if ((UnitGetOwner(libNtve_gf_KillingUnit()) == gv_itemRoboute)) {
            gv_killerOfTombWorld = gv_itemRoboute;
        }

        if ((UnitGetOwner(libNtve_gf_KillingUnit()) == gv_itemTau)) {
            gv_killerOfTombWorld = gv_itemTau;
        }

        TriggerEnable(gt_ActivateScavengeNecronTechnology, true);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_TombWorldDeath_Init () {
    gt_TombWorldDeath = TriggerCreate("gt_TombWorldDeath_Func");
    TriggerAddEventUnitDied(gt_TombWorldDeath, UnitRefFromUnit(UnitFromId(2141419645)));
}

//--------------------------------------------------------------------------------------------------
// Trigger: Activate Scavenge Necron Technology
//--------------------------------------------------------------------------------------------------
bool gt_ActivateScavengeNecronTechnology_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == gv_killerOfTombWorld))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeHeroic) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetUpgradeLevelForPlayer(gv_killerOfTombWorld, "ScavengeNecronTechnology", 1);
    TriggerEnable(TriggerGetCurrent(), false);
    UIDisplayMessage(PlayerGroupSingle(gv_killerOfTombWorld), c_messageAreaSubtitle, StringExternal("Param/Value/647710FE"));
    UnitKill(gv_scavengeNecronTechnologyBeacon);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ActivateScavengeNecronTechnology_Init () {
    gt_ActivateScavengeNecronTechnology = TriggerCreate("gt_ActivateScavengeNecronTechnology_Func");
    TriggerEnable(gt_ActivateScavengeNecronTechnology, false);
    TriggerAddEventUnitRegion(gt_ActivateScavengeNecronTechnology, null, RegionFromId(46), true);
}

