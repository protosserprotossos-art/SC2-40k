}

//--------------------------------------------------------------------------------------------------
// Trigger: Trigger Uncrowned Monarch
//--------------------------------------------------------------------------------------------------
bool gt_TriggerUncrownedMonarch_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_triggeringunit;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_triggeringunit = EventUnit();

    // Conditions
    if (testConds) {
        if (!((UnitGroupCount(gv_robouteStructures, c_unitCountAlive) <= 4))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) == "RaynorLab"))) {
            return false;
        }

        if (!((gv_uncrownedMonarchConditionsfulfilled == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_triggeringunit = EventUnit();
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/266B3B9F"));
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "RobouteGuilliman", 0, gv_itemRoboute, UnitGetPosition(lv_triggeringunit));
    gv_robouteGuiliman = UnitLastCreated();
    gf_AddSpawnerstostructuregroup(UnitLastCreated());
    UnitBehaviorAdd(UnitLastCreated(), "Invulnerabledisabledweapon", gv_macragge, 1);
    if ((UnitHasBehavior2(lv_triggeringunit, "ChosenOfTheGodEmperor") == true)) {
        UnitBehaviorAdd(gv_robouteGuiliman, "ChosenOfTheGodEmperor", gv_macragge, 1);
    }

    libNtve_gf_SetUpgradeLevelForPlayer(gv_itemRoboute, "RobouteAscendant", 1);
    TriggerExecute(gt_UncrownedMonarchSoundtrack, true, false);
    Wait(0.1, c_timeGame);
    UnitAbilitySpendExplicit(gv_robouteGuiliman, AbilityCommand("PsionicShockwave", 0), c_spendLocationAbility, 1.0, 1.0, 1.0, 1.0);
    UnitIssueOrder(gv_robouteGuiliman, Order(AbilityCommand("PsionicShockwave", 0)), c_orderQueueReplace);
    return true;
}

