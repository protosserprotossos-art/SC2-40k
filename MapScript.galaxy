//--------------------------------------------------------------------------------------------------
// Trigger: Retake Devlan From The Tyranids Activate (Highlords Quest)
//--------------------------------------------------------------------------------------------------
bool gt_RetakeDevlanFromTheTyranidsActivateHighlordsQuest_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(2.0, c_timeGame);
    if (((UnitGetOwner(EventUnit()) == gv_itemJorgumandr) || (UnitGetOwner(EventUnit()) == gv_itemKraken) || (UnitGetOwner(EventUnit()) == gv_itemLeviathan))) {
        gv_retakeDevlanFromTyranidsCanActivate = true;
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_RetakeDevlanFromTheTyranidsActivateHighlordsQuest_Init () {
    gt_RetakeDevlanFromTheTyranidsActivateHighlordsQuest = TriggerCreate("gt_RetakeDevlanFromTheTyranidsActivateHighlordsQuest_Func");
    TriggerAddEventUnitBehaviorChange(gt_RetakeDevlanFromTheTyranidsActivateHighlordsQuest, UnitRefFromUnit(UnitFromId(847778748)), "Lessthen5Spawner", c_unitBehaviorChangeActivate);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Retake Devlan From The Tyranids Active (Highlords Quest)
//--------------------------------------------------------------------------------------------------
bool gt_RetakeDevlanFromTheTyranidsActiveHighlordsQuest_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(2.0, c_timeGame);
    if ((UnitGetOwner(EventUnit()) == gv_itemHighlord) && (gv_retakeDevlanFromTyranidsActive == true) && (UnitCount(null, gv_itemHighlord, RegionEntireMap(), UnitFilter((1 << c_targetFilterHeroic), 0, (1 << c_targetFilterHover) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0) > 1)) {
        RegionSetCenter(RegionFromId(65), UnitGetPosition(EventUnit()));
        UnitBehaviorAdd(UnitGroupClosestToPoint(UnitGroup(null, gv_itemHighlord, RegionEntireMap(), UnitFilter((1 << c_targetFilterHeroic), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), RegionGetCenter(RegionFromId(65))), "ChampionOfDevlan", gv_devlan, 1);
        ObjectiveSetState(gv_retakeDevlanFromTyranidsUI, c_objectiveStateCompleted);
        gv_retakeDevlanFromTyranidsActive = false;
        TriggerEnable(TriggerGetCurrent(), false);
    }

    if (((UnitGetOwner(EventUnit()) == gv_itemLion) || (UnitGetOwner(EventUnit()) == gv_itemRoboute) || (UnitGetOwner(EventUnit()) == gv_itemTau) || (UnitGetOwner(EventUnit()) == gv_itemNecrons)) && (gv_retakeDevlanFromTyranidsActive == true)) {
        gv_retakeDevlanFromTyranidsActive = false;
        ObjectiveSetState(gv_retakeDevlanFromTyranidsUI, c_objectiveStateFailed);
        TriggerEnable(TriggerGetCurrent(), false);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_RetakeDevlanFromTheTyranidsActiveHighlordsQuest_Init () {
    gt_RetakeDevlanFromTheTyranidsActiveHighlordsQuest = TriggerCreate("gt_RetakeDevlanFromTheTyranidsActiveHighlordsQuest_Func");
    TriggerAddEventUnitBehaviorChange(gt_RetakeDevlanFromTheTyranidsActiveHighlordsQuest, UnitRefFromUnit(UnitFromId(847778748)), "Lessthen5Spawner", c_unitBehaviorChangeActivate);
}

