//--------------------------------------------------------------------------------------------------
// Trigger: Controller Of Holy Terra (Full Imperium War Timer)
//--------------------------------------------------------------------------------------------------
bool gt_ControllerOfHolyTerraFullImperiumWarTimer_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_controllerOfHolyTerraNotActivated == true))) {
            return false;
        }

        if (!(((gv_robouteHighlordsAtWar == true) || (gv_highlordsLionAtWar == true)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_controllerOfHolyTerraNotActivated = false;
    Wait(1500.0, c_timeGame);
    if ((UnitGetOwner(gv_terra) == gv_itemHighlord)) {
        UIDisplayMessage(PlayerGroupSingle(gv_itemRoboute), c_messageAreaSubtitle, StringExternal("Param/Value/C8723278"));
        gv_unityStacksHighlord += 1;
        TriggerExecute(gt_UnityUIRoboute, true, false);
        TriggerExecute(gt_UnityUILion, true, false);
        TriggerExecute(gt_UnityUIHighlords, true, false);
        TriggerExecute(gt_UnityChangeStatsRoboute, true, false);
        TriggerExecute(gt_UnityChangeStatsLion, true, false);
        TriggerExecute(gt_UnityChangeStatsHighlord, true, false);
    }

    if ((UnitGetOwner(gv_terra) == gv_itemLion)) {
        UIDisplayMessage(PlayerGroupSingle(gv_itemRoboute), c_messageAreaSubtitle, StringExternal("Param/Value/B2FC69F9"));
        gv_unityStacksLion += 1;
        TriggerExecute(gt_UnityUIRoboute, true, false);
        TriggerExecute(gt_UnityUILion, true, false);
        TriggerExecute(gt_UnityUIHighlords, true, false);
        TriggerExecute(gt_UnityChangeStatsRoboute, true, false);
        TriggerExecute(gt_UnityChangeStatsLion, true, false);
        TriggerExecute(gt_UnityChangeStatsHighlord, true, false);
    }

    if ((UnitGetOwner(gv_terra) == gv_itemRoboute)) {
        UIDisplayMessage(PlayerGroupSingle(gv_itemRoboute), c_messageAreaSubtitle, StringExternal("Param/Value/EA154106"));
        gv_unityStacksRoboute += 1;
        TriggerExecute(gt_UnityUIRoboute, true, false);
        TriggerExecute(gt_UnityUILion, true, false);
        TriggerExecute(gt_UnityUIHighlords, true, false);
        TriggerExecute(gt_UnityChangeStatsRoboute, true, false);
        TriggerExecute(gt_UnityChangeStatsLion, true, false);
        TriggerExecute(gt_UnityChangeStatsHighlord, true, false);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ControllerOfHolyTerraFullImperiumWarTimer_Init () {
    gt_ControllerOfHolyTerraFullImperiumWarTimer = TriggerCreate("gt_ControllerOfHolyTerraFullImperiumWarTimer_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Full All Out War
//--------------------------------------------------------------------------------------------------
bool gt_FullAllOutWar_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_robouteLionAtWar == true))) {
            return false;
        }

        if (!((gv_robouteHighlordsAtWar == true))) {
            return false;
        }

        if (!((gv_highlordsLionAtWar == true))) {
            return false;
        }

        if (!((gv_tauNecronsAtWar == true))) {
            return false;
        }

        if (!((gv_imperiumTauAtWar == true))) {
            return false;
        }

        if (!((gv_imperiumNecronsAtWar == true))) {
            return false;
        }

        if (!((gv_fullalloutwarNotActivated == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_fullalloutwarNotActivated = false;
    TriggerEnable(TriggerGetCurrent(), false);
    Wait(25.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/5BFD76F8"));
    Wait(35.0, c_timeGame);
    UIDisplayMessage(PlayerGroupSingle(gv_itemHighlord), c_messageAreaSubtitle, StringExternal("Param/Value/03BB2274"));
    UIDisplayMessage(PlayerGroupSingle(gv_itemLion), c_messageAreaSubtitle, StringExternal("Param/Value/0C24CE09"));
    UIDisplayMessage(PlayerGroupSingle(gv_itemRoboute), c_messageAreaSubtitle, StringExternal("Param/Value/52F1CDE1"));
    gv_unityStacksRoboute += 1;
    gv_unityStacksLion += 1;
    gv_unityStacksHighlord += 1;
    TriggerExecute(gt_UnityUIRoboute, true, false);
    TriggerExecute(gt_UnityUILion, true, false);
    TriggerExecute(gt_UnityUIHighlords, true, false);
    TriggerExecute(gt_UnityChangeStatsRoboute, true, false);
    TriggerExecute(gt_UnityChangeStatsLion, true, false);
    TriggerExecute(gt_UnityChangeStatsHighlord, true, false);
    return true;
}

