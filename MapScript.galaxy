    point lv_point;
    string lv_research;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_spawner = gv_estaban;
    lv_point = PointFromId(907884331);
    lv_research = "EstabanUpgradeSpawn";

    // Conditions
    if (testConds) {
        if (!((libNtve_gf_TriggeringProgressUpgrade() == lv_research))) {
            return false;
        }

        if (!((UnitIsAlive(lv_spawner) == true))) {
            return false;
        }

        if (!((EventUnit() == lv_spawner))) {
            return false;
        }

        if (!(((UnitGetOwner(EventUnit()) == gv_itemHighlord)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) == 4)) {
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) == 3)) {
        gv_titanPieces += 1;
        if ((gv_titanPieces == 5)) {
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/66742672"));
            gf_CreateunitHeroic("Odin", lv_spawner, lv_point);
            SoundPlayForPlayer(SoundLink("Titan_Birth", -1), c_maxPlayers, PlayerGroupAll(), 250.0, 0.0);
        }
        else {
            UIDisplayMessage(PlayerGroupSingle(gv_itemHighlord), c_messageAreaSubtitle, (StringExternal("Param/Value/A0C54D60") + (IntToText(gv_titanPieces) + StringExternal("Param/Value/160B2C10"))));
        }
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) == 2)) {
        gf_CreateunitHeroic("SiegeBreaker", lv_spawner, lv_point);
        SoundPlayForPlayer(SoundLink("Basilisk_Birth", -1), c_maxPlayers, PlayerGroupSingle(UnitGetOwner(lv_spawner)), 250.0, 0.0);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) == 1)) {
        TriggerExecute(gt_ConstructWeaponB24HighCalLasrifleBeacon, true, false);
    }

    return true;
}

