//--------------------------------------------------------------------------------------------------
// Trigger: Spawn/despawn Genestealer Insurrection (Ogrys)
//--------------------------------------------------------------------------------------------------
bool gt_SpawndespawnGenestealerInsurrectionOgrys_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(295.0, c_timeGame);
    if ((TechTreeUpgradeCount(gv_itemJorgumandr, "GenestealerRisingOgrys", c_techCountCompleteOnly) == 1)) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "GenestealerInsurrection", c_unitCreateIgnorePlacement, 0, PointFromId(1167421351));
        gv_genestealerInsurrectionOgrysBeacon = UnitLastCreated();
        TriggerEnable(gt_ActivateGenestealerInsurrectionOgrys, true);
        Wait(180.0, c_timeGame);
        TriggerEnable(gt_ActivateGenestealerInsurrectionOgrys, false);
        UnitKill(gv_genestealerInsurrectionOgrysBeacon);
    }
    else {
        libNtve_gf_SetUpgradeLevelForPlayer(gv_itemJorgumandr, "GenestealerRisingOgrys", 1);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_SpawndespawnGenestealerInsurrectionOgrys_Init () {
    gt_SpawndespawnGenestealerInsurrectionOgrys = TriggerCreate("gt_SpawndespawnGenestealerInsurrectionOgrys_Func");
    TriggerAddEventTimeElapsed(gt_SpawndespawnGenestealerInsurrectionOgrys, 5.0, c_timeGame);
}

