//--------------------------------------------------------------------------------------------------
// Trigger: Change Alliance War
//--------------------------------------------------------------------------------------------------
bool gt_ChangeAllianceWar_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_tauImperiumLoyalty <= 0)) {
        gv_triumColationPreserved = false;
        gv_imperiumTauAtWar = true;
        libNtve_gf_SetAlliance(gv_itemHighlord, gv_itemTau, libNtve_ge_AllianceSetting_Enemy);
        libNtve_gf_SetAlliance(gv_itemLion, gv_itemTau, libNtve_ge_AllianceSetting_Enemy);
        libNtve_gf_SetAlliance(gv_itemRoboute, gv_itemTau, libNtve_ge_AllianceSetting_Enemy);
        TriggerExecute(gt_FullAllOutWar, true, false);
        TriggerExecute(gt_UIUpdate, true, false);
        libNtve_gf_SetUpgradeLevelForPlayer(gv_itemTau, "UnknownUpgrade", 1);
        TriggerExecute(gt_SubvertTigrusActivated, true, false);
        UnitKill(gv_subvertThePopulationOfTigrusBeacon);
        TriggerEnable(gt_SubvertTigrusActivated, false);
        TriggerEnable(gt_SubvertTigrusActivate, false);
    }

    if ((gv_imperiumNecronLoyalty <= 0)) {
        gv_triumColationPreserved = false;
        gv_imperiumNecronsAtWar = true;
        libNtve_gf_SetAlliance(gv_itemHighlord, gv_itemNecrons, libNtve_ge_AllianceSetting_Enemy);
        libNtve_gf_SetAlliance(gv_itemLion, gv_itemNecrons, libNtve_ge_AllianceSetting_Enemy);
        libNtve_gf_SetAlliance(gv_itemRoboute, gv_itemNecrons, libNtve_ge_AllianceSetting_Enemy);
        TriggerExecute(gt_FullAllOutWar, true, false);
        TriggerExecute(gt_UIUpdate, true, false);
    }

    if ((gv_tauNecronLoyalty <= 0)) {
        gv_triumColationPreserved = false;
        gv_tauNecronsAtWar = true;
        TriggerExecute(gt_FullAllOutWar, true, false);
        libNtve_gf_SetAlliance(gv_itemTau, gv_itemNecrons, libNtve_ge_AllianceSetting_Enemy);
        TriggerExecute(gt_UIUpdate, true, false);
    }

    return true;
}

