//--------------------------------------------------------------------------------------------------
bool gt_InwitImperium_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_spawner;
    point lv_point;
    string lv_research;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_spawner = gv_inwit;
    lv_point = PointFromId(998113049);
    lv_research = "InwitUpgradeSpawn";

    // Conditions
    if (testConds) {
        if (!((UnitIsAlive(lv_spawner) == true))) {
            return false;
        }

        if (!((PlayerGetPropertyInt(UnitGetOwner(lv_spawner), c_playerPropSuppliesUsed) <= PlayerGetPropertyInt(UnitGetOwner(lv_spawner), c_playerPropSuppliesMade)))) {
            return false;
        }

        if (!((UnitGetOwner(lv_spawner) != 0))) {
            return false;
        }

        if (!(((UnitGetOwner(lv_spawner) == gv_itemHighlord) || (UnitGetOwner(lv_spawner) == gv_itemLion) || (UnitGetOwner(lv_spawner) == gv_itemRoboute) || (UnitGetOwner(lv_spawner) == gv_itemWarringStates)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(0.25, c_timeGame);
    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 5)) {
        gf_CreateunitBattleCruiser(1, lv_spawner, lv_point);
        gf_CreateunitWraith(1, lv_spawner, lv_point);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 4)) {
        gf_CreateunitBattleCruiser(1, lv_spawner, lv_point);
        gf_CreateunitWraith(1, lv_spawner, lv_point);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 3)) {
        gf_CreateunitWraith(1, lv_spawner, lv_point);
        gf_Createunit(1, "VikingAssault", lv_spawner, lv_point);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 2)) {
        gf_CreateunitWraith(1, lv_spawner, lv_point);
        gf_Createunit(1, "Goliath", lv_spawner, lv_point);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 1) && (gv_battleshipSpawner == false)) {
        gf_CreateunitWraith(1, lv_spawner, lv_point);
        gf_Createunit(1, "Goliath", lv_spawner, lv_point);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 0) && (gv_battleshipSpawner == false)) {
        gf_AISpawnerResearchTauChaos(lv_spawner, lv_point, "AIresearch");
        gf_CreateunitWraith(1, lv_spawner, lv_point);
        gf_CreateunitRocketGuardsmanSpaceMarine(2, lv_spawner, lv_point);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), "RetreatOgrys", c_techCountCompleteOnly) >= 1)) {
        gf_CreateunitBasilisk(1, "SiegeTank", lv_spawner, lv_point, "VikingAssault");
        gf_Createunit(1, "Marine", lv_spawner, lv_point);
        gf_Createunit(1, "Goliath", lv_spawner, lv_point);
        gf_Createunit(1, "Marine", lv_spawner, lv_point);
        gf_Createunit(2, "Separatist", lv_spawner, lv_point);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), "RetreatAthonos", c_techCountCompleteOnly) >= 1)) {
        gf_Createunit(1, "Marine", lv_spawner, lv_point);
        gf_Createunit(1, "Goliath", lv_spawner, lv_point);
        gf_Createunit(1, "VikingAssault", lv_spawner, lv_point);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), "RetreatGehennaPrime", c_techCountCompleteOnly) >= 1)) {
        gf_Createunit(1, "Marine", lv_spawner, lv_point);
        gf_Createunit(1, "Goliath", lv_spawner, lv_point);
        gf_CreateunitMeleeAlternatives(3, lv_spawner, lv_point);
        gf_CreateunitRocketGuardsmanSpaceMarine(3, lv_spawner, lv_point);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), "RetreatKrieg", c_techCountCompleteOnly) >= 1)) {
        gf_CreateunitBasilisk(1, "SiegeTank", lv_spawner, lv_point, "VikingAssault");
        gf_Createunit(6, "Separatist", lv_spawner, lv_point);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), "RetreatBellusPrime", c_techCountCompleteOnly) >= 1)) {
        gf_CreateunitMeleeAlternatives(1, lv_spawner, lv_point);
        gf_Createunit(1, "Goliath", lv_spawner, lv_point);
        gf_Createunit(1, "Goliath", lv_spawner, lv_point);
        gf_Createunit(1, "Separatist", lv_spawner, lv_point);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), "RetreatTigrus", c_techCountCompleteOnly) >= 1)) {
        gf_Createunit(1, "Marine", lv_spawner, lv_point);
        gf_Createunit(1, "Goliath", lv_spawner, lv_point);
        gf_Createunit(1, "Marine", lv_spawner, lv_point);
        gf_Createunit(3, "Separatist", lv_spawner, lv_point);
    }

    return true;
}

