void gt_TyranidWar_Init () {
    gt_TyranidWar = TriggerCreate("gt_TyranidWar_Func");
    TriggerAddEventUnitAbility(gt_TyranidWar, null, AbilityCommand("SinkingOfTheKraken", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_TyranidWar, null, AbilityCommand("DrowningoftheLeviathan", 0), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(gt_TyranidWar, null, AbilityCommand("ScuttlingofJorgumandr", 0), c_unitAbilStageExecute, false);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Roboute - Highlord War
//--------------------------------------------------------------------------------------------------
bool gt_RobouteHighlordWar_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((EventUnitAbility() == AbilityCommand("TheAvengingSonsWrath", 0)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_imperiumPreserved = false;
    gv_robouteHighlordsAtWar = true;
    gv_unityStacksRoboute += 2;
    gv_unityStacksHighlord += 1;
    libNtve_gf_SetUpgradeLevelForPlayer(gv_itemRoboute, "TheAvengingSonsWrath", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(gv_itemHighlord, "PurgeoftheAvengingSon", 1);
    TriggerExecute(gt_UnityUIRoboute, true, false);
    TriggerExecute(gt_UnityUILion, true, false);
    TriggerExecute(gt_UnityUIHighlords, true, false);
    TriggerExecute(gt_UnityChangeStatsRoboute, true, false);
    TriggerExecute(gt_UnityChangeStatsLion, true, false);
    TriggerExecute(gt_UnityChangeStatsHighlord, true, false);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/BC39589D"));
    Wait(15.0, c_timeGame);
    libNtve_gf_SetAlliance(gv_itemRoboute, gv_itemHighlord, libNtve_ge_AllianceSetting_Enemy);
    TriggerExecute(gt_FullAllOutWar, true, false);
    TriggerExecute(gt_ControllerOfHolyTerraFullImperiumWarTimer, true, false);
    return true;
}

