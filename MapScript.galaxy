//--------------------------------------------------------------------------------------------------
// Trigger: Activate Tomb Worlds
//--------------------------------------------------------------------------------------------------
bool gt_ActivateTombWorlds_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_tombWorldsAmount == 4)) {
        TriggerEnable(TriggerGetCurrent(), false);
    }
    else if ((RandomInt(1, 2) == 1) && (gv_tombWorldsAmount < 4) && (gv_tombWorldActivatedArray[1] == false)) {
        gv_tombWorldActivatedArray[1] = true;
        gv_tombWorldsAmount += 1;
        Wait(600.0, c_timeGame);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "TombWorld2", c_unitCreateIgnorePlacement, 0, PointFromId(1228861502));
        gv_tombWorldBeaconIce = UnitLastCreated();
        TriggerEnable(gt_CreateTombWorldIce, true);
        Wait(300.0, c_timeGame);
        UnitKill(gv_tombWorldBeaconIce);
        TriggerEnable(gt_CreateTombWorldIce, false);
    }
    else if ((RandomInt(1, 2) == 1) && (gv_tombWorldsAmount < 4) && (gv_tombWorldActivatedArray[2] == false)) {
        gv_tombWorldActivatedArray[2] = true;
        gv_tombWorldsAmount += 1;
        Wait(720.0, c_timeGame);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "TombWorld3", c_unitCreateIgnorePlacement, 0, PointFromId(456394704));
        gv_tombWorldBeaconAthonos = UnitLastCreated();
        TriggerEnable(gt_CreateTombWorldAthonos, true);
        Wait(300.0, c_timeGame);
        UnitKill(gv_tombWorldBeaconAthonos);
        TriggerEnable(gt_CreateTombWorldAthonos, false);
    }
    else if ((RandomInt(1, 2) == 1) && (gv_tombWorldsAmount < 4) && (gv_tombWorldActivatedArray[3] == false)) {
        gv_tombWorldActivatedArray[3] = true;
        gv_tombWorldsAmount += 1;
        Wait(720.0, c_timeGame);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "TombWorld4", c_unitCreateIgnorePlacement, 0, PointFromId(1523404726));
        gv_tombWorldBeaconFalShia = UnitLastCreated();
        TriggerEnable(gt_CreateTombWorldFalShia, true);
        Wait(300.0, c_timeGame);
        UnitKill(gv_tombWorldBeaconFalShia);
        TriggerEnable(gt_CreateTombWorldFalShia, false);
    }
    else if ((RandomInt(1, 2) == 1) && (gv_tombWorldsAmount < 4) && (gv_tombWorldActivatedArray[4] == false)) {
        gv_tombWorldActivatedArray[4] = true;
        gv_tombWorldsAmount += 1;
        Wait(720.0, c_timeGame);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "TombWorld42", c_unitCreateIgnorePlacement, 0, PointFromId(1832423234));
        gv_tombWorldBeaconCanta = UnitLastCreated();
        TriggerEnable(gt_CreateTombWorldCanta, true);
        Wait(300.0, c_timeGame);
        UnitKill(gv_tombWorldBeaconCanta);
        TriggerEnable(gt_CreateTombWorldFalShia, false);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ActivateTombWorlds_Init () {
    gt_ActivateTombWorlds = TriggerCreate("gt_ActivateTombWorlds_Func");
    TriggerAddEventTimePeriodic(gt_ActivateTombWorlds, 5.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Create Tomb World (Ice)
//--------------------------------------------------------------------------------------------------
bool gt_CreateTombWorldIce_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_tombWorld;
    unit lv_beacon;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_tombWorld = gv_tombWorldIce;
    lv_beacon = gv_tombWorldBeaconIce;

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == gv_itemNecrons))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeHeroic) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    UnitKill(lv_beacon);
    Wait(3.0, c_timeGame);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "VoidPylon", 0, 0, PointFromId(592467746));
    UnitBehaviorAddPlayer(UnitLastCreated(), "ArtanisStasisField", 0, 1);
