//--------------------------------------------------------------------------------------------------
bool gt_Necrontryingtosoftlock_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitIsAlive(gv_trazynTheInfinite) == false) && (UnitIsAlive(gv_imotekhTheStormlord) == false) && (UnitIsAlive(UnitFromId(1244147445)) == false)) {
        gv_necrontryingtosoftlock = true;
        TriggerExecute(gt_Defeatcons, true, false);
    }

    return true;
}

