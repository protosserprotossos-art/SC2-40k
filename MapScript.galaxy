void gf_AISpawnerResearchTauChaos (unit lp_spawner, point lp_point, string lp_research) {
    // Automatic Variable Declarations
    // Implementation
    if ((UnitIsAlive(lp_spawner) == true) && (PlayerGetPropertyInt(UnitGetOwner(lp_spawner), c_playerPropSuppliesUsed) <= PlayerGetPropertyInt(UnitGetOwner(lp_spawner), c_playerPropSuppliesMade)) && (UnitGetOwner(lp_spawner) != 0) && (TechTreeUpgradeCount(UnitGetOwner(lp_spawner), "AIresearch", c_techCountCompleteOnly) >= 1) && ((UnitGetOwner(lp_spawner) == gv_itemTau) || (UnitGetOwner(lp_spawner) == gv_itemWarringStates))) {
        Wait(0.25, c_timeGame);
        if ((TechTreeUpgradeCount(UnitGetOwner(lp_spawner), lp_research, c_techCountCompleteOnly) >= 4)) {
            gf_CreateunitwithcapColossus(1, lp_spawner, lp_point);
            gf_Createunit(1, "StalkerPurifier", lp_spawner, lp_point);
            gf_Createunit(2, "ZealotPurifier", lp_spawner, lp_point);
        }

        if ((TechTreeUpgradeCount(UnitGetOwner(lp_spawner), lp_research, c_techCountCompleteOnly) >= 3)) {
            gf_Createunit(2, "PhoenixPurifier", lp_spawner, lp_point);
            gf_Createunit(1, "StalkerPurifier", lp_spawner, lp_point);
            gf_Createunit(1, "ZealotPurifier", lp_spawner, lp_point);
        }

        if ((TechTreeUpgradeCount(UnitGetOwner(lp_spawner), lp_research, c_techCountCompleteOnly) >= 2)) {
            gf_Createunit(2, "StalkerPurifier", lp_spawner, lp_point);
        }

        if ((TechTreeUpgradeCount(UnitGetOwner(lp_spawner), lp_research, c_techCountCompleteOnly) >= 1)) {
            gf_Createunit(2, "ZealotPurifier", lp_spawner, lp_point);
        }

    }

}

