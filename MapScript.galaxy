        gv_lionElJonssonPowerupMinor += 1;
        libNtve_gf_SetUpgradeLevelForPlayer(UnitGetOwner(lv_spawner), "LionElJonssonPowerupMinor", gv_lionElJonssonPowerupMinor);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) == 2)) {
        gv_lionElJonssonPowerupMinor += 1;
        libNtve_gf_SetUpgradeLevelForPlayer(UnitGetOwner(lv_spawner), "LionElJonssonPowerupMinor", gv_lionElJonssonPowerupMinor);
    }

