//--------------------------------------------------------------------------------------------------
// Trigger: Tau - Imperium Temorary War
//--------------------------------------------------------------------------------------------------
bool gt_TauImperiumTemoraryWar_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "UnknownUpgrade", 1);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/6394D444"));
    Wait(25.0, c_timeGame);
    TriggerExecute(gt_SubvertTigrusActivated, true, false);
    libNtve_gf_SetAlliance(gv_itemHighlord, gv_itemTau, libNtve_ge_AllianceSetting_Enemy);
    libNtve_gf_SetAlliance(gv_itemLion, gv_itemTau, libNtve_ge_AllianceSetting_Enemy);
    libNtve_gf_SetAlliance(gv_itemRoboute, gv_itemTau, libNtve_ge_AllianceSetting_Enemy);
    gf_LoyaltyTauImperium(10, false);
    Wait(300.0, c_timeGame);
    if ((gv_tauImperiumLoyalty >= 0)) {
        libNtve_gf_SetAlliance(gv_itemHighlord, gv_itemTau, libNtve_ge_AllianceSetting_Ally);
        libNtve_gf_SetAlliance(gv_itemLion, gv_itemTau, libNtve_ge_AllianceSetting_Ally);
        libNtve_gf_SetAlliance(gv_itemRoboute, gv_itemTau, libNtve_ge_AllianceSetting_Ally);
        libNtve_gf_SetAllianceAspectForPlayerGroup(gv_triumColation, c_allianceIdSeekHelp, false);
    }

    return true;
}

