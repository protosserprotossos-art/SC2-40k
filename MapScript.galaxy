//--------------------------------------------------------------------------------------------------
// Trigger: Chiron Fortify
//--------------------------------------------------------------------------------------------------
bool gt_ChironFortify_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto7FE8DBB3_g;
    int auto7FE8DBB3_u;
    unit auto7FE8DBB3_var;

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == gv_itemJorgumandr))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeHeroic) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitKill(gv_chironFortifyBeacon);
    auto7FE8DBB3_g = UnitGroup(null, gv_itemJorgumandr, RegionFromId(40), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto7FE8DBB3_u = UnitGroupCount(auto7FE8DBB3_g, c_unitCountAll);
    for (;; auto7FE8DBB3_u -= 1) {
        auto7FE8DBB3_var = UnitGroupUnitFromEnd(auto7FE8DBB3_g, auto7FE8DBB3_u);
        if (auto7FE8DBB3_var == null) { break; }
        UnitBehaviorAdd(auto7FE8DBB3_var, "FortifyChiron", gv_chiron, 1);
    }
    UIDisplayMessage(PlayerGroupSingle(gv_itemJorgumandr), c_messageAreaSubtitle, StringExternal("Param/Value/D7965F4A"));
    TriggerEnable(TriggerGetCurrent(), false);
    return true;
}

