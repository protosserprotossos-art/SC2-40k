//--------------------------------------------------------------------------------------------------
// Trigger: Quest Starter
//--------------------------------------------------------------------------------------------------
bool gt_QuestStarter_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    while ((gv_questsStarted < 3)) {
        Wait(240.0, c_timeGame);
        if ((RandomInt(1, 2) == 1) && (gv_questsActivatedArray[1] == false)) {
            gv_questsStarted += 1;
            ObjectiveCreateForPlayers(StringExternal("Param/Value/F0D009A5"), StringExternal("Param/Value/32CA02B6"), c_objectiveStateActive, false, PlayerGroupSingle(gv_itemHighlord));
            gv_questsActivatedArray[1] = true;
            gv_killAKrakenHeroQuestActive = true;
            gv_killAKrakenHeroObjectiveUI = ObjectiveLastCreated();
        }
        else if ((RandomInt(1, 2) == 1) && (gv_questsActivatedArray[2] == false)) {
            gv_questsStarted += 1;
            ObjectiveCreateForPlayers(StringExternal("Param/Value/5DB8AE0B"), StringExternal("Param/Value/DC208CD4"), c_objectiveStateActive, false, PlayerGroupSingle(gv_itemHighlord));
            gv_questsActivatedArray[2] = true;
            gv_killAJorgumandrHeroQuestActive = true;
            gv_killAJorgumandrHeroObjectiveUI = ObjectiveLastCreated();
        }
        else if ((RandomInt(1, 2) == 1) && (gv_questsActivatedArray[3] == false)) {
            gv_questsStarted += 1;
            ObjectiveCreateForPlayers(StringExternal("Param/Value/589F04E1"), StringExternal("Param/Value/9CD3A0BF"), c_objectiveStateActive, false, PlayerGroupSingle(gv_itemHighlord));
            gv_questsActivatedArray[3] = true;
            gv_killALeviathanHeroQuestActive = true;
            gv_killALeviathanHeroObjectiveUI = ObjectiveLastCreated();
        }
        else if ((RandomInt(1, 2) == 1) && (gv_questsActivatedArray[4] == false)) {
            gv_questsStarted += 1;
            ObjectiveCreateForPlayers(StringExternal("Param/Value/11110660"), StringExternal("Param/Value/CE205C6D"), c_objectiveStateActive, false, PlayerGroupSingle(gv_itemHighlord));
            gv_questsActivatedArray[4] = true;
            gv_killLionElJonsonQuestActive = true;
            gv_killLioneljonsonObjectiveUI = ObjectiveLastCreated();
        }
        else if ((RandomInt(1, 2) == 1) && (gv_questsActivatedArray[5] == false)) {
            gv_questsStarted += 1;
            ObjectiveCreateForPlayers(StringExternal("Param/Value/0839986F"), StringExternal("Param/Value/28B11CFB"), c_objectiveStateActive, false, PlayerGroupSingle(gv_itemHighlord));
            gv_questsActivatedArray[5] = true;
            gv_killRobouteGuilimanQuestActive = true;
            gv_killRobouteGuilimanObjectiveUI = ObjectiveLastCreated();
        }
        else if ((RandomInt(1, 2) == 1) && (gv_questsActivatedArray[6] == false) && (gv_retakeDevlanFromTyranidsCanActivate == true)) {
            gv_questsStarted += 1;
            ObjectiveCreateForPlayers(StringExternal("Param/Value/5B9E5D2F"), StringExternal("Param/Value/2E4DA7CE"), c_objectiveStateActive, false, PlayerGroupSingle(gv_itemHighlord));
            gv_questsActivatedArray[6] = true;
            gv_retakeDevlanFromTyranidsActive = true;
            gv_retakeDevlanFromTyranidsUI = ObjectiveLastCreated();
        }
    }
    return true;
}

