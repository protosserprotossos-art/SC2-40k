//--------------------------------------------------------------------------------------------------
// Trigger: Dev - Unity
//--------------------------------------------------------------------------------------------------
bool gt_DevUnity_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gf_Developer(EventPlayer()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventPlayer() == gv_itemHighlord)) {
        gv_unityStacksHighlord += 10;
    }

    if ((EventPlayer() == gv_itemLion)) {
        gv_unityStacksLion += 10;
    }

    if ((EventPlayer() == gv_itemRoboute)) {
        gv_unityStacksRoboute += 10;
    }

    TriggerExecute(gt_UnityUIRoboute, true, false);
    TriggerExecute(gt_UnityUILion, true, false);
    TriggerExecute(gt_UnityUIHighlords, true, false);
    TriggerExecute(gt_UnityChangeStatsRoboute, true, false);
    TriggerExecute(gt_UnityChangeStatsLion, true, false);
    TriggerExecute(gt_UnityChangeStatsHighlord, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_DevUnity_Init () {
    gt_DevUnity = TriggerCreate("gt_DevUnity_Func");
    TriggerAddEventChatMessage(gt_DevUnity, c_playerAny, "-unity", false);
}

