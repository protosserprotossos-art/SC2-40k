void gf_DefenseSpawnbasicground (unit lp_attackingUnit, int lp_playerTeam, point lp_point) {
    // Automatic Variable Declarations
    // Implementation
    if (((lp_playerTeam == gv_itemHighlord) || (lp_playerTeam == gv_itemLion) || (lp_playerTeam == gv_itemRoboute) || (lp_playerTeam == gv_itemWarringStates))) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "AutoTurret", c_unitCreateIgnorePlacement, 0, lp_point);
        libNtve_gf_RescueUnit(UnitLastCreated(), UnitGetOwner(lp_attackingUnit), true);
    }
    else if (((lp_playerTeam == gv_itemLeviathan) || (lp_playerTeam == gv_itemJorgumandr) || (lp_playerTeam == gv_itemKraken))) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "SpineCrawler", c_unitCreateIgnorePlacement, 0, lp_point);
        libNtve_gf_RescueUnit(UnitLastCreated(), UnitGetOwner(lp_attackingUnit), true);
    }
    else if ((lp_playerTeam == gv_itemTau)) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "PhotonCannon", c_unitCreateIgnorePlacement, 0, lp_point);
        libNtve_gf_RescueUnit(UnitLastCreated(), UnitGetOwner(lp_attackingUnit), true);
    }
    else if ((lp_playerTeam == gv_itemNecrons)) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "NecronFortificaiton", c_unitCreateIgnorePlacement, 0, lp_point);
        libNtve_gf_RescueUnit(UnitLastCreated(), UnitGetOwner(lp_attackingUnit), true);
    }
    UnitBehaviorAddPlayer(UnitLastCreated(), "ArtanisStasisField", 0, 1);
}

