    UnitGroupClear(gv_robouteAIGroup);
    UnitGroupClear(gv_tauAIGroup);
    UnitGroupClear(gv_necronsAIGroup);
    UnitGroupClear(gv_leviathanAIGroup);
    UnitGroupClear(gv_jorgumandrAIGroup);
    UnitGroupClear(gv_krakenAIGroup);
    UnitGroupClear(gv_warringStatesAIGroup);
    TriggerExecute(gt_InitializeAIGroups, true, false);
    return true;
}

