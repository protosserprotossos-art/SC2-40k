bool gt_SetupHotjoin_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_achivementDialogXsize;
    int lv_achivementDialogYsize;
    int lv_loopIndex;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_achivementDialogXsize = 900;
    lv_achivementDialogYsize = 600;
    lv_loopIndex = 1;

    // Actions
    if (!runActions) {
        return true;
    }

    DialogCreate(lv_achivementDialogXsize, lv_achivementDialogYsize, c_anchorCenter, 0, 0, false);
    gv_hotjoinDialog = DialogLastCreated();
    DialogSetImageVisible(gv_hotjoinDialog, true);
    libNtve_gf_CreateDialogItemImage(gv_hotjoinDialog, lv_achivementDialogXsize, lv_achivementDialogYsize, c_anchorTopLeft, 0, 0, StringToText(""), "Assets\\Textures\\ui_research_frame_confirmationwindow.dds", c_triggerImageTypeHorizontalBorder, true, Color(100,100,100), c_triggerBlendModeNormal);
    libNtve_gf_SetDialogItemRenderPriority(DialogControlLastCreated(), 511, PlayerGroupAll());
    libNtve_gf_CreateDialogItemLabel(gv_hotjoinDialog, 240, 50, c_anchorTop, 65, -50, StringExternal("Param/Value/BF0628B9"), ColorWithAlpha(0,0,0,0), false, 2.0);
    libNtve_gf_CreateDialogItemButton(gv_hotjoinDialog, 50, 50, c_anchorTopRight, 25, 25, StringExternal("Param/Value/31C19570"), StringExternal("Param/Value/6A539108"), "");
    libNtve_gf_SetDialogItemRenderPriority(DialogControlLastCreated(), 513, PlayerGroupAll());
    libNtve_gf_SetDialogItemColor(DialogControlLastCreated(), Color(100.00, 0.00, 0.00), PlayerGroupAll());
    gv_hotjoinDialogButtonClose = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_hotjoinDialog, 200, 150, c_anchorCenter, 275, 100, StringExternal("Param/Value/641C8A61"), StringExternal("Param/Value/F671B7FC"), "");
    gv_highlordsButton = DialogControlLastCreated();
    DialogControlSetEnabled(gv_highlordsButton, PlayerGroupAll(), false);
    libNtve_gf_CreateDialogItemButton(gv_hotjoinDialog, 200, 150, c_anchorCenter, 275, -100, StringExternal("Param/Value/38526F03"), StringExternal("Param/Value/BCDBA6B7"), "");
    gv_lionButton = DialogControlLastCreated();
    DialogControlSetEnabled(gv_lionButton, PlayerGroupAll(), false);
    libNtve_gf_CreateDialogItemButton(gv_hotjoinDialog, 200, 150, c_anchorCenter, 75, -100, StringExternal("Param/Value/C68F00D5"), StringExternal("Param/Value/5A506C32"), "");
    gv_robouteButton = DialogControlLastCreated();
    DialogControlSetEnabled(gv_robouteButton, PlayerGroupAll(), false);
    libNtve_gf_CreateDialogItemButton(gv_hotjoinDialog, 200, 150, c_anchorCenter, 75, 100, StringExternal("Param/Value/A2043A32"), StringExternal("Param/Value/B6544519"), "");
    gv_tauButton = DialogControlLastCreated();
    DialogControlSetEnabled(gv_tauButton, PlayerGroupAll(), false);
    libNtve_gf_CreateDialogItemButton(gv_hotjoinDialog, 200, 150, c_anchorCenter, -125, 100, StringExternal("Param/Value/9C7436F2"), StringExternal("Param/Value/60194DD8"), "");
    gv_necronButton = DialogControlLastCreated();
    DialogControlSetEnabled(gv_necronButton, PlayerGroupAll(), false);
    libNtve_gf_CreateDialogItemButton(gv_hotjoinDialog, 200, 150, c_anchorCenter, -125, -100, StringExternal("Param/Value/D78A5D44"), StringExternal("Param/Value/1505B53F"), "");
    gv_leviathanButton = DialogControlLastCreated();
    DialogControlSetEnabled(gv_leviathanButton, PlayerGroupAll(), false);
    libNtve_gf_CreateDialogItemButton(gv_hotjoinDialog, 200, 150, c_anchorCenter, -325, -100, StringExternal("Param/Value/764500B9"), StringExternal("Param/Value/C682239C"), "");
    gv_jorgumandrButton = DialogControlLastCreated();
    DialogControlSetEnabled(gv_jorgumandrButton, PlayerGroupAll(), false);
    libNtve_gf_CreateDialogItemButton(gv_hotjoinDialog, 200, 150, c_anchorCenter, -325, 100, StringExternal("Param/Value/A5C3FDE2"), StringExternal("Param/Value/4BAAC014"), "");
    gv_krakenButton = DialogControlLastCreated();
    DialogControlSetEnabled(gv_krakenButton, PlayerGroupAll(), false);
    DialogSetVisible(gv_dialogAchievement, PlayerGroupAll(), false);
    return true;
