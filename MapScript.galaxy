//--------------------------------------------------------------------------------------------------
// Trigger: T'au Research checker
//--------------------------------------------------------------------------------------------------
bool gt_TauResearchchecker_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_tier1ResearchAmount == 5) && (gv_technologyResearchBeaconNotSpawned[1] == false)) {
        TriggerExecute(gt_SpawnTauResearchtier1, true, false);
        gv_technologyResearchBeaconNotSpawned[1] = true;
    }

    if ((gv_tier2ResearchAmount == 5) && (gv_technologyResearchBeaconNotSpawned[2] == false)) {
        TriggerExecute(gt_SpawnTauResearchtier2, true, false);
        gv_technologyResearchBeaconNotSpawned[2] = true;
    }

    if ((gv_tier3ResearchAmount == 5) && (gv_technologyResearchBeaconNotSpawned[3] == false)) {
        TriggerExecute(gt_SpawnTauResearchtier3, true, false);
        gv_technologyResearchBeaconNotSpawned[3] = true;
    }

    return true;
}

