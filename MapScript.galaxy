    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((EventDialogControl() == gv_dialogAllyScreenItemClose2))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    DialogSetVisible(gv_dialogAchievement, PlayerGroupSingle(EventPlayer()), false);
    return true;
}

