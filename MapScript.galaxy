//--------------------------------------------------------------------------------------------------
// Trigger: Attack Hero Handler
//--------------------------------------------------------------------------------------------------
bool gt_AttackHeroHandler_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_highlordsAIActive == true) && (UnitGetOwner(EventUnit()) == gv_itemHighlord)) {
        UnitGroupAdd(gv_highlordAIGroup, EventUnit());
        gv_highlordsIndex += 1;
    }
    else if ((gv_lionAIActive == true) && (UnitGetOwner(EventUnit()) == gv_itemLion)) {
        UnitGroupAdd(gv_lionAIGroup, EventUnit());
        gv_lionIndex += 1;
    }
    else if ((gv_robouteAIActive == true) && (UnitGetOwner(EventUnit()) == gv_itemRoboute)) {
        UnitGroupAdd(gv_robouteAIGroup, EventUnit());
        gv_robouteIndex += 1;
    }
    else if ((gv_tauAIActive == true) && (UnitGetOwner(EventUnit()) == gv_itemTau)) {
        UnitGroupAdd(gv_tauAIGroup, EventUnit());
        gv_tauIndex += 1;
    }
    else if ((gv_necronsAIActive == true) && (UnitGetOwner(EventUnit()) == gv_itemNecrons)) {
        UnitGroupAdd(gv_necronsAIGroup, EventUnit());
        gv_necronIndex += 1;
    }
    else if ((gv_leviathanAIActive == true) && (UnitGetOwner(EventUnit()) == gv_itemLeviathan)) {
        UnitGroupAdd(gv_leviathanAIGroup, EventUnit());
        gv_leviathanIndex += 1;
    }
    else if ((gv_jorgumandrAIActive == true) && (UnitGetOwner(EventUnit()) == gv_itemJorgumandr)) {
        UnitGroupAdd(gv_jorgumandrAIGroup, EventUnit());
        gv_jorgumandrIndex += 1;
    }
    else if ((gv_krakenAIActive == true) && (UnitGetOwner(EventUnit()) == gv_itemKraken)) {
        UnitGroupAdd(gv_krakenAIGroup, EventUnit());
        gv_krakenIndex += 1;
    }
    else if ((gv_warringStatesAIActive == true) && (UnitGetOwner(EventUnit()) == gv_itemWarringStates)) {
        UnitGroupAdd(gv_warringStatesAIGroup, EventUnit());
        gv_warringStatesIndex += 1;
    }
    return true;
}

