//--------------------------------------------------------------------------------------------------
// Trigger: Spawn controll transference
//--------------------------------------------------------------------------------------------------
bool gt_Spawncontrolltransference_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_startingOwnerOfTriggeirngUnit;
    unit lv_attackingUnit;
    unit lv_spyUnit;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeStructure) == true))) {
            return false;
        }

        if (!((UnitBehaviorCount(EventUnit(), "Lessthen5Spawner") == 1))) {
            return false;
        }

        if (!((gv_spawnTransferenceLocker == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(gt_SpawnControllTransferenceStartTimer, true, false);
    lv_startingOwnerOfTriggeirngUnit = UnitGetOwner(EventUnit());
    lv_attackingUnit = EventUnitDamageSourceUnit();
    lv_spyUnit = gf_GetSpyFromUnit(EventUnitDamageSourceUnit());
    if ((UnitGetOwner(lv_attackingUnit) == 0)) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/499B7541"));
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, UnitGetName(EventUnitDamageSourceUnit()));
    }

    if ((EventUnit() == gv_terra) && ((UnitGetOwner(lv_attackingUnit) == gv_itemTau) || (UnitGetOwner(lv_attackingUnit) == gv_itemNecrons) || (UnitGetOwner(lv_attackingUnit) == gv_itemKraken) || (UnitGetOwner(lv_attackingUnit) == gv_itemJorgumandr) || (UnitGetOwner(lv_attackingUnit) == gv_itemLeviathan))) {
    }
    else {
        libNtve_gf_RescueUnit(EventUnit(), UnitGetOwner(lv_attackingUnit), true);
        UnitSetPropertyFixed(EventUnit(), c_unitPropLife, 50000.0);
        UnitBehaviorAdd(EventUnit(), "ArtanisStasisField", lv_spyUnit, 1);
        gf_HandleStructureGroups(EventUnit());
        gf_Spawncontrolltransference(lv_startingOwnerOfTriggeirngUnit, EventUnit(), lv_attackingUnit, UnitGetOwner(lv_attackingUnit));
        if ((UnitHasBehavior2(EventUnit(), "InfestedProtossBiomass") == true)) {
            UnitBehaviorRemove(EventUnit(), "InfestedProtossBiomass", 1);
            UnitBehaviorRemove(EventUnit(), "ColonyInfestation", 1);
        }

        if (((UnitGetOwner(lv_attackingUnit) == gv_itemKraken) || (UnitGetOwner(lv_attackingUnit) == gv_itemJorgumandr) || (UnitGetOwner(lv_attackingUnit) == gv_itemLeviathan))) {
            gf_IncreaseDevouringHunger(lv_attackingUnit);
            if (((UnitGetType(EventUnit()) != "Spire") || (UnitGetType(EventUnit()) != "SpawningPool") || (UnitGetType(EventUnit()) != "RoachWarren") || (UnitGetType(EventUnit()) != "LurkerDenMP") || (UnitGetType(EventUnit()) != "BanelingNest") || (UnitGetType(EventUnit()) != "EvolutionChamber") || (UnitGetType(EventUnit()) != "Hatchery") || (UnitGetType(EventUnit()) != "InfestationPit") || (UnitGetType(EventUnit()) != "CarrionNest"))) {
                UnitBehaviorAdd(EventUnit(), "InfestedProtossBiomass", lv_spyUnit, 1);
                UnitBehaviorAdd(EventUnit(), "ColonyInfestation", lv_spyUnit, 1);
                if ((UnitGetOwner(EventUnit()) == 0)) {
                    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/A2F18A74"));
                    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, UnitGetName(lv_spyUnit));
                }

            }

        }

    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Spawncontrolltransference_Init () {
    gt_Spawncontrolltransference = TriggerCreate("gt_Spawncontrolltransference_Func");
    TriggerAddEventUnitDamageAbsorbed(gt_Spawncontrolltransference, null, "Lessthen5Spawner");
}

