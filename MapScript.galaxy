//--------------------------------------------------------------------------------------------------
// Trigger: callAIResearch(Highlords) (improved variant)
//--------------------------------------------------------------------------------------------------
bool gt_callAIResearchHighlordsimprovedvariant_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_player;
    int lv_index;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_player = gv_itemHighlord;

    // Conditions
    if (testConds) {
        if (!((gv_highlordsAIActive == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gf_AiResearchlesser(gv_researchIndexInteger[lv_player], lv_player, 2, gv_devlan, "DevlanUpgradeSpawn", "DevlanUpgradeSpawn", AbilityCommand("DevlanUpgradeSpawn", 0));
    gf_AiResearchlesser(gv_researchIndexInteger[lv_player], lv_player, 2, gv_terra, "TerraUpgradeSpawn", "HolyTerraUpgradeSpawn", AbilityCommand("TerraUpgradeSpawn", 0));
    gf_AiResearchlesser(gv_researchIndexInteger[lv_player], lv_player, 3, gv_estaban, "EstabanUpgradeSpawn", "EstabanUpgradeSpawn", AbilityCommand("EstabanUpgradeSpawn", 0));
    gf_AiResearchlesser(gv_researchIndexInteger[lv_player], lv_player, 3, gv_betaGarmonIV, "BetaGarmonIVUpgradeSpawn", "BetaGarmonIVUpgradeSpawn", AbilityCommand("BetaGarmonIVUpgradeSpawn", 0));
    gf_AiResearchlesser(gv_researchIndexInteger[lv_player], lv_player, 3, gv_fortress, "FortressUpgradeSpawn", "FortressUpgradeSpawn", AbilityCommand("FortressUpgradeSpawn", 0));
    gf_AiResearchlesser(gv_researchIndexInteger[lv_player], lv_player, 3, gv_eyriePrime, "EyriePrimeUpgradeSpawn", "EyriePrimeUpgradeSpawn", AbilityCommand("EyriePrimeUpgradeSpawn", 0));
    gf_AiResearchlesser(gv_researchIndexInteger[lv_player], lv_player, gv_holyTerraUpgradeLevel, gv_terra, "TerraUpgradeSpawn", "HolyTerraUpgradeSpawn", AbilityCommand("TerraUpgradeSpawn", 0));
    gf_AiResearchlesser(gv_researchIndexInteger[lv_player], lv_player, gv_molechUpgradeLevel, gv_moloch, "MolochUpgradeSpawn", "MolochUpgradeSpawn", AbilityCommand("MolochUpgradeSpawn", 0));
    return true;
}

