//--------------------------------------------------------------------------------------------------
// Trigger: Player Leaves
//--------------------------------------------------------------------------------------------------
bool gt_PlayerLeaves_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventPlayer() == gv_itemHighlord)) {
        if ((gv_highlordsDefeated == true)) {
            gv_highlordsAIActive = false;
        }
        else {
            gv_highlordsAIActive = true;
        }
        gv_highlordsDefeated = true;
        TriggerExecute(gt_PlayerleavesAllianceaspecthandler, true, false);
    }

    if ((EventPlayer() == gv_itemLion)) {
        if ((gv_lionDefeated == true)) {
            gv_lionAIActive = false;
        }
        else {
            gv_lionAIActive = true;
        }
        gv_lionDefeated = true;
        TriggerExecute(gt_PlayerleavesAllianceaspecthandler, true, false);
    }

    if ((EventPlayer() == gv_itemRoboute)) {
        if ((gv_robouteDefeated == true)) {
            gv_robouteAIActive = false;
        }
        else {
            gv_robouteAIActive = true;
        }
        gv_robouteDefeated = true;
        TriggerExecute(gt_PlayerleavesAllianceaspecthandler, true, false);
    }

    if ((EventPlayer() == gv_itemTau)) {
        if ((gv_tauDefeated == true)) {
            gv_tauAIActive = false;
        }
        else {
            gv_tauAIActive = true;
        }
        gv_tauDefeated = true;
        TriggerExecute(gt_PlayerleavesAllianceaspecthandler, true, false);
    }

    if ((EventPlayer() == gv_itemNecrons)) {
        if ((gv_necronDefeated == true)) {
            gv_necronsAIActive = false;
        }
        else {
            gv_necronsAIActive = true;
        }
        gv_necronDefeated = true;
        TriggerExecute(gt_PlayerleavesAllianceaspecthandler, true, false);
    }

    if ((EventPlayer() == gv_itemLeviathan)) {
        if ((gv_leviathanDefeated == true)) {
            gv_leviathanAIActive = false;
        }
        else {
            gv_leviathanAIActive = true;
        }
        gv_leviathanDefeated = true;
        TriggerExecute(gt_PlayerleavesAllianceaspecthandler, true, false);
    }

    if ((EventPlayer() == gv_itemJorgumandr)) {
        if ((gv_jorgumandrDefeated == true)) {
            gv_jorgumandrAIActive = false;
        }
        else {
            gv_jorgumandrAIActive = true;
        }
        gv_jorgumandrDefeated = true;
        TriggerExecute(gt_PlayerleavesAllianceaspecthandler, true, false);
    }

    if ((EventPlayer() == gv_itemKraken)) {
        if ((gv_krakenDefeated == true)) {
            gv_krakenAIActive = false;
        }
        else {
            gv_krakenAIActive = true;
        }
        gv_krakenDefeated = true;
        TriggerExecute(gt_PlayerleavesAllianceaspecthandler, true, false);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_PlayerLeaves_Init () {
    gt_PlayerLeaves = TriggerCreate("gt_PlayerLeaves_Func");
    TriggerAddEventPlayerLeft(gt_PlayerLeaves, c_playerAny, c_gameResultUndecided);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Player leaves (Alliance aspect handler
//--------------------------------------------------------------------------------------------------
bool gt_PlayerleavesAllianceaspecthandler_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetAllianceAspectForPlayerGroup(gv_triumColation, c_allianceIdSpend, false);
    libNtve_gf_SetAllianceAspectForPlayerGroup(gv_triumColation, c_allianceIdSpend, false);
    libNtve_gf_SetAllianceAspectForPlayerGroup(gv_triumColation, c_allianceIdVision, false);
    libNtve_gf_SetAllianceAspectForPlayerGroup(gv_tyranids, c_allianceIdSpend, false);
    libNtve_gf_SetAllianceAspectForPlayerGroup(gv_tyranids, c_allianceIdControl, false);
    libNtve_gf_SetAllianceAspectForPlayerGroup(gv_tyranids, c_allianceIdVision, true);
    libNtve_gf_SetAllianceAspectForPlayerGroup(gv_triumColation, c_allianceIdSeekHelp, false);
    libNtve_gf_SetAllianceAspectForPlayerGroup(gv_tyranids, c_allianceIdSeekHelp, false);
    if ((gv_krakenDefeated == true)) {
    }

    if ((gv_jorgumandrDefeated == true)) {
    }

    if ((gv_leviathanDefeated == true)) {
    }

