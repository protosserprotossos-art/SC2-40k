//--------------------------------------------------------------------------------------------------
// Trigger: Dev - Kick #
//--------------------------------------------------------------------------------------------------
bool gt_DevKick_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_inputInteger;
    int lv_playerItemValue;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((gf_Developer(EventPlayer()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_inputInteger = StringToInt(StringSub(EventChatMessage(false), 6, StringLength(EventChatMessage(false))));
    if ((gf_PlayerValueexists(lv_inputInteger) == true)) {
        lv_playerItemValue = gf_GetPlayerItemValueByIntegerindex(lv_inputInteger);
        KickFromGame(PlayerGroupSingle(lv_playerItemValue));
        UIDisplayMessage(PlayerGroupSingle(EventPlayer()), c_messageAreaSubtitle, StringExternal("Param/Value/FD131968"));
    }
    else {
        UIDisplayMessage(PlayerGroupSingle(EventPlayer()), c_messageAreaSubtitle, StringExternal("Param/Value/FF418A1D"));
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_DevKick_Init () {
    gt_DevKick = TriggerCreate("gt_DevKick_Func");
    TriggerAddEventChatMessage(gt_DevKick, c_playerAny, "-kick", false);
}

