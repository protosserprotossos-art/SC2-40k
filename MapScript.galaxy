//--------------------------------------------------------------------------------------------------
bool gt_Purificationprotocl_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_spawnersDead;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "PurificationProtocol", 1);
    lv_spawnersDead = UnitGroupCount(gv_megaUnitSpawnerGroup, c_unitCountDead);
    PlayerModifyPropertyInt(gv_itemNecrons, c_playerPropSuppliesMade, c_playerPropOperAdd, (lv_spawnersDead * 10));
    gf_LoyaltyTauNecron(25, false);
    gf_LoyaltyImperiumNecron(25, false);
    gv_purificationProtocol = true;
    TriggerEnable(gt_PurificationProtocolSpawnRate, true);
    return true;
}

