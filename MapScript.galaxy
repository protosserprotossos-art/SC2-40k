    gt_ShowAchievementDialog = TriggerCreate("gt_ShowAchievementDialog_Func");
    TriggerAddEventDialogControl(gt_ShowAchievementDialog, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

