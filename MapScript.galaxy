//--------------------------------------------------------------------------------------------------
// Trigger: Necron C'tan Shards Create
//--------------------------------------------------------------------------------------------------
bool gt_NecronCtanShardsCreate_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_index;

    // Automatic Variable Declarations
    const int auto1322E274_ae = 4;
    const int auto1322E274_ai = 1;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(gt_NecronCtanShardsBeacons, true);
    gv_ctanshardsRegionsarray[1] = RegionFromId(71);
    gv_ctanshardsRegionsarray[2] = RegionFromId(72);
    gv_ctanshardsRegionsarray[3] = RegionFromId(73);
    gv_ctanshardsRegionsarray[4] = RegionFromId(74);
    while ((gv_ctanShardBeaconsCreated < 2)) {
        Wait(1.0, c_timeGame);
        lv_index = 1;
        for ( ; ( (auto1322E274_ai >= 0 && lv_index <= auto1322E274_ae) || (auto1322E274_ai < 0 && lv_index >= auto1322E274_ae) ) ; lv_index += auto1322E274_ai ) {
            if ((RandomInt(1, 2) == 1) && (gv_ctanShardActvatedArrays[lv_index] == false)) {
                gv_ctanShardBeaconsCreated = (gv_ctanShardBeaconsCreated + 1);
                gv_ctanShardActvatedArrays[lv_index] = true;
                gf_CtanShardsspawn(lv_index);
                gv_ctanShardBeaconsArray[lv_index] = UnitLastCreated();
            }

        }
    }
    return true;
}

