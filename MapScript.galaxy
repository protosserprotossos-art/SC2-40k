//--------------------------------------------------------------------------------------------------
// Trigger: Constantin Valdor Beacon Activations
//--------------------------------------------------------------------------------------------------
bool gt_ConstantinValdorBeaconActivations_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_integer;

    // Automatic Variable Declarations
    const int autoE535AA1E_ae = 7;
    const int autoE535AA1E_ai = 1;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == gv_itemRoboute))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeHeroic) == true))) {
            return false;
        }

        if (!(((UnitGetType(EventUnit()) == "RaynorLab") || (UnitGetType(EventUnit()) == "RobouteGuilliman")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_integer = 1;
    for ( ; ( (autoE535AA1E_ai >= 0 && lv_integer <= autoE535AA1E_ae) || (autoE535AA1E_ai < 0 && lv_integer >= autoE535AA1E_ae) ) ; lv_integer += autoE535AA1E_ai ) {
        if ((EventUnitRegion() == gv_constantinValdorCluesRegionsArray[lv_integer]) && (gv_constantinValdorCluesActivatedArray[lv_integer] == true)) {
            gv_constantinValdorCluesActivatedArray[lv_integer] = false;
            UnitKill(gv_constantinValdorCluesBeaconsArray[lv_integer]);
            gv_constantinValdorCluesCompleted += 1;
            TriggerExecute(gt_ConstantinValdorSpawn, true, false);
        }

    }
    return true;
}

