//--------------------------------------------------------------------------------------------------
// Trigger: Invite Roboute To Terra Activate
//--------------------------------------------------------------------------------------------------
bool gt_InviteRobouteToTerraActivate_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == gv_itemRoboute))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeHeroic) == true))) {
            return false;
        }

        if (!(((UnitGetType(EventUnit()) == "RaynorLab") || (UnitGetType(EventUnit()) == "RobouteGuilliman")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitKill(gv_inviteRobouteToTerraBeacon);
    UnitBehaviorAdd(gv_robouteGuiliman, "UncommandableSuper", gv_terra, 1);
    Wait(3.0, c_timeGame);
    UIDisplayMessage(PlayerGroupSingle(gv_itemRoboute), c_messageAreaSubtitle, StringExternal("Param/Value/1341C6F5"));
    Wait(15.0, c_timeGame);
    UIDisplayMessage(PlayerGroupSingle(gv_itemRoboute), c_messageAreaSubtitle, StringExternal("Param/Value/1901A258"));
    Wait(15.0, c_timeGame);
    UIDisplayMessage(PlayerGroupSingle(gv_itemRoboute), c_messageAreaSubtitle, StringExternal("Param/Value/DCC08383"));
    Wait(15.0, c_timeGame);
    UIDisplayMessage(PlayerGroupSingle(gv_itemRoboute), c_messageAreaSubtitle, StringExternal("Param/Value/A82CCD18"));
    Wait(15.0, c_timeGame);
    UIDisplayMessage(PlayerGroupSingle(gv_itemRoboute), c_messageAreaSubtitle, StringExternal("Param/Value/5F20C177"));
    Wait(15.0, c_timeGame);
    UIDisplayMessage(PlayerGroupSingle(gv_itemRoboute), c_messageAreaSubtitle, StringExternal("Param/Value/037B3DC7"));
    Wait(10.0, c_timeGame);
    UIDisplayMessage(PlayerGroupSingle(gv_itemRoboute), c_messageAreaSubtitle, StringExternal("Param/Value/1B1D1986"));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/765DA58C"));
    UnitBehaviorRemove(gv_robouteGuiliman, "UncommandableSuper", 1);
    UnitBehaviorAdd(gv_robouteGuiliman, "ChosenOfTheGodEmperor", gv_terra, 1);
    TriggerEnable(TriggerGetCurrent(), false);
    Wait(60.0, c_timeGame);
    TriggerExecute(gt_ConstantinValdorsstartHints, true, false);
    return true;
}

