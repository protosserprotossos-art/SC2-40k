    if ((gv_tauNecronsAtWar == false)) {
        libNtve_gf_SetDialogItemText(DialogControlLastCreated(), (StringExternal("Param/Value/55A74BD1") + IntToText(gv_tauNecronLoyalty)), PlayerGroupAll());
    }
