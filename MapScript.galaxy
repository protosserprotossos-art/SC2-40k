void gt_RegionMoveCaller_Init () {
    gt_RegionMoveCaller = TriggerCreate("gt_RegionMoveCaller_Func");
    TriggerAddEventTimePeriodic(gt_RegionMoveCaller, 5.0, c_timeGame);
}

