//--------------------------------------------------------------------------------------------------
// Trigger: Spawn/despawn Genestealer Insurrection (Athonos)
//--------------------------------------------------------------------------------------------------
bool gt_SpawndespawnGenestealerInsurrectionAthonos_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(475.0, c_timeGame);
    if ((TechTreeUpgradeCount(gv_itemJorgumandr, "GenestealerRisingAthonos", c_techCountCompleteOnly) == 1)) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "GenestealerInsurrection", c_unitCreateIgnorePlacement, 0, PointFromId(2067996124));
        gv_genestealerInsurrectionAthonosBeacon = UnitLastCreated();
        TriggerEnable(gt_ActivateGenestealerInsurrectionAthonos, true);
        Wait(180.0, c_timeGame);
        TriggerEnable(gt_ActivateGenestealerInsurrectionAthonos, false);
        UnitKill(gv_genestealerInsurrectionAthonosBeacon);
    }
    else {
        libNtve_gf_SetUpgradeLevelForPlayer(gv_itemJorgumandr, "GenestealerRisingAthonos", 1);
    }
    return true;
}

