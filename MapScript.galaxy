//--------------------------------------------------------------------------------------------------
// Trigger: Devlan (Tyranid)
//--------------------------------------------------------------------------------------------------
bool gt_DevlanTyranid_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_spawner;
    point lv_point;
    string lv_research;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_spawner = gv_devlan;
    lv_point = PointFromId(226241248);
    lv_research = "DevlanUpgradeSpawn";

    // Conditions
    if (testConds) {
        if (!((UnitIsAlive(lv_spawner) == true))) {
            return false;
        }

        if (!((PlayerGetPropertyInt(UnitGetOwner(lv_spawner), c_playerPropSuppliesUsed) <= PlayerGetPropertyInt(UnitGetOwner(lv_spawner), c_playerPropSuppliesMade)))) {
            return false;
        }

        if (!((UnitGetOwner(lv_spawner) != 0))) {
            return false;
        }

        if (!(((UnitGetOwner(lv_spawner) == gv_itemLeviathan) || (UnitGetOwner(lv_spawner) == gv_itemJorgumandr) || (UnitGetOwner(lv_spawner) == gv_itemKraken)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(0.25, c_timeGame);
    gf_CreateunitTyranidBuilder(1, lv_spawner, lv_point);
    gf_CreateunitMutalisk(2, "Mutalisk", lv_spawner, lv_point, "Hydralisk");
    gf_Createunit(1, "Hydralisk", lv_spawner, lv_point);
    gf_Createunit(1, "Zergling", lv_spawner, lv_point);
    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 4)) {
        gf_CreateunitGuardian(1, "Guardian", lv_spawner, lv_point, "Ultralisk");
        gf_CreateunitMutalisk(2, "Mutalisk", lv_spawner, lv_point, "Hydralisk");
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 3)) {
        gf_Createunit(2, "Hydralisk", lv_spawner, lv_point);
        gf_CreateunitMutalisk(1, "Mutalisk", lv_spawner, lv_point, "Hydralisk");
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 2)) {
        gf_Createunit(2, "Hydralisk", lv_spawner, lv_point);
        gf_CreateunitTyranidSkyHarbinger(1, lv_spawner, lv_point);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 1)) {
        gf_CreateunitMutalisk(1, "Mutalisk", lv_spawner, lv_point, "Hydralisk");
        gf_Createunit(2, "Zergling", lv_spawner, lv_point);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_DevlanTyranid_Init () {
    gt_DevlanTyranid = TriggerCreate("gt_DevlanTyranid_Func");
    TriggerAddEventTimePeriodic(gt_DevlanTyranid, 90.0, c_timeGame);
}

