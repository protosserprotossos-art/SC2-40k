//--------------------------------------------------------------------------------------------------
// Trigger: Roboute aura controller
//--------------------------------------------------------------------------------------------------
bool gt_Robouteauracontroller_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "RobouteAuraCooldown5minutes", 1);
    TriggerExecute(gt_RobouteauracontrollerTimer, true, false);
    if ((EventUnitAbility() == AbilityCommand("RobouteAuraUnyieldingDefense", 0))) {
        UnitBehaviorAdd(gv_robouteGuiliman, "RobouteGuillimanUnyieldingFortressAuraAura", UnitFromId(1797122141), 1);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "RobouteAuraUnyieldingDefensePassive", 1);
    }

    if ((EventUnitAbility() == AbilityCommand("RobouteAuraDevastatingOnslaught", 0))) {
        UnitBehaviorAdd(gv_robouteGuiliman, "RobouteGuillimanDevastatingOnslaughtAuraAura", UnitFromId(1797122141), 1);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "RobouteAuraDevastatingOnslaughtPassive", 1);
    }

    if ((EventUnitAbility() == AbilityCommand("RobouteAuraFocusedBarrage", 0))) {
        UnitBehaviorAdd(gv_robouteGuiliman, "RobouteGuillimanFocusedBarrageAuraAura", UnitFromId(1797122141), 1);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "RobouteAuraFocusedBarragePassive", 1);
    }

    if ((EventUnitAbility() == AbilityCommand("RobouteAuraRelentlessAdvance", 0))) {
        UnitBehaviorAdd(gv_robouteGuiliman, "RobouteGuillimanRelentlessAdvanceAuraAura", UnitFromId(1797122141), 1);
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "RobouteAuraRelentlessAdvancePassive", 1);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Robouteauracontroller_Init () {
    gt_Robouteauracontroller = TriggerCreate("gt_Robouteauracontroller_Func");
    TriggerAddEventUnitAbility(gt_Robouteauracontroller, null, AbilityCommand("RobouteAuraUnyieldingDefense", 0), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_Robouteauracontroller, null, AbilityCommand("RobouteAuraFocusedBarrage", 0), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_Robouteauracontroller, null, AbilityCommand("RobouteAuraDevastatingOnslaught", 0), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_Robouteauracontroller, null, AbilityCommand("RobouteAuraRelentlessAdvance", 0), c_unitAbilStageComplete, false);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Roboute aura controller Timer
//--------------------------------------------------------------------------------------------------
bool gt_RobouteauracontrollerTimer_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(300.0, c_timeGame);
    libNtve_gf_SetUpgradeLevelForPlayer(UnitGetOwner(gv_robouteGuiliman), "RobouteAuraCooldown5minutes", 0);
    UnitBehaviorRemove(gv_robouteGuiliman, "RobouteGuillimanUnyieldingFortressAuraAura", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "RobouteAuraUnyieldingDefensePassive", 0);
    UnitBehaviorRemove(gv_robouteGuiliman, "RobouteGuillimanFocusedBarrageAuraAura", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "RobouteAuraFocusedBarragePassive", 0);
    UnitBehaviorRemove(gv_robouteGuiliman, "RobouteGuillimanDevastatingOnslaughtAuraAura", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "RobouteAuraDevastatingOnslaughtPassive", 0);
    UnitBehaviorRemove(gv_robouteGuiliman, "RobouteGuillimanRelentlessAdvanceAuraAura", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "RobouteAuraDevastatingOnslaughtPassive", 0);
    return true;
}

