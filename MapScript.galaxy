        if (!((EventUnitAbility() == AbilityCommand("LionsPride", 0)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_imperiumPreserved = false;
    gv_robouteLionAtWar = true;
    gv_unityStacksLion += 2;
    gv_unityStacksRoboute += 1;
    libNtve_gf_SetUpgradeLevelForPlayer(gv_itemLion, "LionsPride", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(gv_itemRoboute, "ChallengeofthePrimarchs", 1);
    TriggerExecute(gt_UnityUIRoboute, true, false);
    TriggerExecute(gt_UnityUILion, true, false);
    TriggerExecute(gt_UnityUIHighlords, true, false);
    TriggerExecute(gt_UnityChangeStatsRoboute, true, false);
    TriggerExecute(gt_UnityChangeStatsLion, true, false);
    TriggerExecute(gt_UnityChangeStatsHighlord, true, false);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/5440A333"));
    Wait(15.0, c_timeGame);
    libNtve_gf_SetAlliance(gv_itemRoboute, gv_itemLion, libNtve_ge_AllianceSetting_Enemy);
    TriggerExecute(gt_FullAllOutWar, true, false);
    TriggerExecute(gt_ControllerOfHolyTerraFullImperiumWarTimer, true, false);
    return true;
}

