    TriggerAddEventTimePeriodic(gt_Enabledisablebuttons, 5.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Hotjoin button triggered
//--------------------------------------------------------------------------------------------------
bool gt_Hotjoinbuttontriggered_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventDialogControl() == gv_highlordsButton)) {
        gf_HotjoinHighlords(gv_itemHighlord, EventPlayer());
        DialogControlSetEnabled(gv_highlordsButton, PlayerGroupAll(), false);
        DialogControlSetEnabled(gv_hotjoinDialogButtonItem, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_hotjoinDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_hotjoinDialogButton, PlayerGroupSingle(EventPlayer()), false);
        DialogControlSetVisible(gv_hotjoinDialogButtonItem, PlayerGroupSingle(EventPlayer()), false);
    }

    if ((EventDialogControl() == gv_lionButton)) {
        gf_HotjoinLion(gv_itemLion, EventPlayer());
        DialogControlSetEnabled(gv_lionButton, PlayerGroupAll(), false);
        DialogControlSetEnabled(gv_hotjoinDialogButtonItem, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_hotjoinDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_hotjoinDialogButton, PlayerGroupSingle(EventPlayer()), false);
        DialogControlSetVisible(gv_hotjoinDialogButtonItem, PlayerGroupSingle(EventPlayer()), false);
    }

    if ((EventDialogControl() == gv_robouteButton)) {
        gf_HotjoinRoboute(gv_itemRoboute, EventPlayer());
        DialogControlSetEnabled(gv_robouteButton, PlayerGroupAll(), false);
        DialogControlSetEnabled(gv_hotjoinDialogButtonItem, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_hotjoinDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_hotjoinDialogButton, PlayerGroupSingle(EventPlayer()), false);
        DialogControlSetVisible(gv_hotjoinDialogButtonItem, PlayerGroupSingle(EventPlayer()), false);
    }

    if ((EventDialogControl() == gv_tauButton)) {
        gf_HotjoinTau(gv_itemTau, EventPlayer());
        DialogControlSetEnabled(gv_tauButton, PlayerGroupAll(), false);
        DialogControlSetEnabled(gv_hotjoinDialogButtonItem, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_hotjoinDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_hotjoinDialogButton, PlayerGroupSingle(EventPlayer()), false);
        DialogControlSetVisible(gv_hotjoinDialogButtonItem, PlayerGroupSingle(EventPlayer()), false);
    }

    if ((EventDialogControl() == gv_necronButton)) {
        gf_HotjoinNecron(gv_itemNecrons, EventPlayer());
        DialogControlSetEnabled(gv_necronButton, PlayerGroupAll(), false);
        DialogControlSetEnabled(gv_hotjoinDialogButtonItem, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_hotjoinDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_hotjoinDialogButton, PlayerGroupSingle(EventPlayer()), false);
        DialogControlSetVisible(gv_hotjoinDialogButtonItem, PlayerGroupSingle(EventPlayer()), false);
    }

    if ((EventDialogControl() == gv_leviathanButton)) {
        gf_HotjoinLeviathan(gv_itemLeviathan, EventPlayer());
        DialogControlSetEnabled(gv_leviathanButton, PlayerGroupAll(), false);
        DialogControlSetEnabled(gv_hotjoinDialogButtonItem, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_hotjoinDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_hotjoinDialogButton, PlayerGroupSingle(EventPlayer()), false);
        DialogControlSetVisible(gv_hotjoinDialogButtonItem, PlayerGroupSingle(EventPlayer()), false);
    }

    if ((EventDialogControl() == gv_jorgumandrButton)) {
        gf_HotjoinJorgumandr(gv_itemJorgumandr, EventPlayer());
        DialogControlSetEnabled(gv_jorgumandrButton, PlayerGroupAll(), false);
        DialogControlSetEnabled(gv_hotjoinDialogButtonItem, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_hotjoinDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_hotjoinDialogButton, PlayerGroupSingle(EventPlayer()), false);
        DialogControlSetVisible(gv_hotjoinDialogButtonItem, PlayerGroupSingle(EventPlayer()), false);
    }

    if ((EventDialogControl() == gv_krakenButton)) {
        gf_HotjoinKraken(gv_itemKraken, EventPlayer());
        DialogControlSetEnabled(gv_krakenButton, PlayerGroupAll(), false);
        DialogControlSetEnabled(gv_hotjoinDialogButtonItem, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_hotjoinDialog, PlayerGroupSingle(EventPlayer()), false);
        DialogSetVisible(gv_hotjoinDialogButton, PlayerGroupSingle(EventPlayer()), false);
        DialogControlSetVisible(gv_hotjoinDialogButtonItem, PlayerGroupSingle(EventPlayer()), false);
    }

    return true;
}

