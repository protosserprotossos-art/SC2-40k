//--------------------------------------------------------------------------------------------------
// Trigger: AI Research Collapse/Revolt
//--------------------------------------------------------------------------------------------------
bool gt_AIResearchCollapseRevolt_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_index;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    while ((RandomInt(0, 20) != 1)) {
        Wait(60.0, c_timeGame);
    }
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/27AF27B3"));
    libNtve_gf_SetUpgradeLevelForPlayer(gv_itemTau, "AIResearchCollapse", 1);
    libNtve_gf_SetUpgradeLevelForPlayer(gv_itemTau, "AIresearch", 0);
    libNtve_gf_SetUpgradeLevelForPlayer(gv_itemWarringStates, "AIresearch", 4);
    Wait(30.0, c_timeGame);
    TriggerExecute(gt_AIRevolthandling, true, false);
    Wait(30.0, c_timeGame);
    UIDisplayMessage(PlayerGroupSingle(gv_itemTau), c_messageAreaSubtitle, StringExternal("Param/Value/DD86600C"));
    gv_technlogyStackstau -= 1;
    libNtve_gf_SetUpgradeLevelForPlayer(gv_itemTau, "TauTechnlogyStacks", gv_technlogyStackstau);
    TriggerExecute(gt_UIUpdate, true, false);
    return true;
}

