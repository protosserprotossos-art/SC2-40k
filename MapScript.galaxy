//--------------------------------------------------------------------------------------------------
// Trigger: Save to bank
//--------------------------------------------------------------------------------------------------
bool gt_Savetobank_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_games;
    int lv_player;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    if ((PlayerType(lv_player) == c_playerTypeUser) && (BankKeyExists(gv_bank[lv_player], "Games", "GamesPlayed") == true)) {
        lv_games = BankValueGetAsInt(BankLastCreated(), "Games", "GamesPlayed");
    }

    lv_games += 1;
    BankValueSetFromInt(BankLastCreated(), "Games", "GamesPlayed", lv_games);
    BankSave(gv_bank[lv_player]);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Savetobank_Init () {
    gt_Savetobank = TriggerCreate("gt_Savetobank_Func");
}

