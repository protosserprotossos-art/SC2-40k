//--------------------------------------------------------------------------------------------------
// Trigger: Activation (start)
//--------------------------------------------------------------------------------------------------
bool gt_Activationstart_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto7ED69564_g;
    int auto7ED69564_u;
    unit auto7ED69564_var;

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == gv_itemNecrons))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeHeroic) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitIssueOrder(EventUnit(), Order(AbilityCommand("que5Passive", 0)), c_orderQueueReplace);
    libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "MainTombWorldEstablished", 1);
    TriggerEnable(TriggerGetCurrent(), false);
    UnitBehaviorAddPlayer(EventUnit(), "ArtanisStasisField", 0, 1);
    Wait(10.0, c_timeGame);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "ArbiterMP", c_unitCreateIgnorePlacement, gv_itemNecrons, PointFromId(184295410));
    gv_necronArbiter = UnitLastCreated();
    UnitKill(UnitFromId(913330309));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/61BE63CB"));
    auto7ED69564_g = gv_tombWorldGroup;
    auto7ED69564_u = UnitGroupCount(auto7ED69564_g, c_unitCountAll);
    for (;; auto7ED69564_u -= 1) {
        auto7ED69564_var = UnitGroupUnitFromEnd(auto7ED69564_g, auto7ED69564_u);
        if (auto7ED69564_var == null) { break; }
        libNtve_gf_RescueUnit(auto7ED69564_var, gv_itemNecrons, true);
    }
    gf_AddSpawnerstostructuregroup(UnitFromId(2141419645));
    gf_LoyaltyTauNecron(5, false);
    gf_LoyaltyTauImperium(2, true);
    gf_LoyaltyImperiumNecron(5, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Activationstart_Init () {
    gt_Activationstart = TriggerCreate("gt_Activationstart_Func");
    TriggerAddEventUnitRegion(gt_Activationstart, null, RegionFromId(2), true);
}

