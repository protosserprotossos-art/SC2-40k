        gv_tier1ResearchAmount += 1;
        TriggerExecute(gt_TauResearchchecker, true, false);
    }

    if ((libNtve_gf_TriggeringProgressUpgrade() == "LongshotSurge")) {
        gv_tier2ResearchAmount += 1;
        TriggerExecute(gt_TauResearchchecker, true, false);
    }

    if ((libNtve_gf_TriggeringProgressUpgrade() == "HarmonicSurge")) {
        gv_tier2ResearchAmount += 1;
        TriggerExecute(gt_TauResearchchecker, true, false);
    }

    if ((libNtve_gf_TriggeringProgressUpgrade() == "WaterCasteAlliances")) {
        gv_tier2ResearchAmount += 1;
        TriggerExecute(gt_TauResearchchecker, true, false);
        gf_LoyaltyTauNecron(6, true);
        gf_LoyaltyTauImperium(6, true);
        gf_LoyaltyImperiumNecron(6, true);
    }

    if ((libNtve_gf_TriggeringProgressUpgrade() == "StreamlinedMunitioning")) {
        gv_tier2ResearchAmount += 1;
        TriggerExecute(gt_TauResearchchecker, true, false);
    }

    if ((libNtve_gf_TriggeringProgressUpgrade() == "ShapersGuard")) {
        gv_tier2ResearchAmount += 1;
        TriggerExecute(gt_TauResearchchecker, true, false);
    }

    if ((libNtve_gf_TriggeringProgressUpgrade() == "BoundlessGuidance")) {
        gv_tier2ResearchAmount += 1;
        TriggerExecute(gt_TauResearchchecker, true, false);
    }

    if ((libNtve_gf_TriggeringProgressUpgrade() == "EtherealAuthority")) {
        gv_tier2ResearchAmount += 1;
        TriggerExecute(gt_TauResearchchecker, true, false);
    }

    if ((libNtve_gf_TriggeringProgressUpgrade() == "LongshotOverdrive")) {
        gv_tier3ResearchAmount += 1;
        TriggerExecute(gt_TauResearchchecker, true, false);
    }

    if ((libNtve_gf_TriggeringProgressUpgrade() == "HarmonicOverdrive")) {
        gv_tier3ResearchAmount += 1;
        TriggerExecute(gt_TauResearchchecker, true, false);
    }

    if ((libNtve_gf_TriggeringProgressUpgrade() == "WaterCasteDominion")) {
        gv_tier3ResearchAmount += 1;
        gf_LoyaltyTauNecron(8, true);
        gf_LoyaltyTauImperium(8, true);
        gf_LoyaltyImperiumNecron(8, true);
        TriggerExecute(gt_TauResearchchecker, true, false);
