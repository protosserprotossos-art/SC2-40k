//--------------------------------------------------------------------------------------------------
// Trigger: Hero Death
//--------------------------------------------------------------------------------------------------
bool gt_HeroDeath_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeHeroic) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGetType(EventUnit()) != "ArtanisVoid")) {
        gf_RemoveSpawnersfromUnitGroup(EventUnit());
        TriggerExecute(gt_Defeatcons, true, false);
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, ((StringExternal("Param/Value/4FFB7187") + TextWithColor(UnitGetName(EventUnit()), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(EventPlayer(), false)))) + (StringExternal("Param/Value/22B98255") + TextWithColor(UnitGetName(libNtve_gf_KillingUnit()), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(UnitGetOwner(libNtve_gf_KillingUnit()), false))))));
        gf_KillaLeviathanHeroHighlordsQuest(libNtve_gf_KillingUnit(), EventUnit());
        gf_KillaKrakenHeroHighlordsQuest(libNtve_gf_KillingUnit(), EventUnit());
        gf_KillaJorgumandrHeroHighlordsQuest(libNtve_gf_KillingUnit(), EventUnit());
        gf_KillRobouteGuilimanHighlordsQuest(libNtve_gf_KillingUnit(), EventUnit());
        gf_KillLionElJonsonHighlordsQuest(libNtve_gf_KillingUnit(), EventUnit());
        gf_FlayedOnesBuff(libNtve_gf_KillingUnit(), EventUnit());
        if (((EventUnit() == gv_trazynTheInfinite) || (EventUnit() == gv_imotekhTheStormlord) || (EventUnit() == UnitFromId(1244147445)))) {
            TriggerExecute(gt_StarttimerNecrontryingtosoftlock, true, false);
        }

    }

    return true;
}

