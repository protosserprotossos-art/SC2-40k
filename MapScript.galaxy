// Trigger: Standardize B-24 High Cal LasRifle Beacon
//--------------------------------------------------------------------------------------------------
bool gt_StandardizeB24HighCalLasRifleBeacon_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((libNtve_gf_UnitGetPropertyKills(EventUnit(), c_unitPropCurrent) >= 100))) {
            return false;
        }

        if (!((TechTreeUpgradeCount(UnitGetOwner(EventUnit()), "GuardsmanUpgrade", c_techCountCompleteOnly) == 1))) {
            return false;
        }

        if (!((TechTreeUpgradeCount(UnitGetOwner(EventUnit()), "VanceStubbSwitchWeapon", c_techCountCompleteOnly) == 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    UIDisplayMessage(PlayerGroupSingle(gv_itemHighlord), c_messageAreaSubtitle, StringExternal("Param/Value/0ABF5D8C"));
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "StandardizeB24HighCalLasRifle", c_unitCreateIgnorePlacement, 0, PointFromId(1474881237));
    gv_standardizeB24HighCalLasRifleBeacon = UnitLastCreated();
    TriggerEnable(gt_StandardizeB24HighCalLasRifleActivate, true);
    return true;
}

