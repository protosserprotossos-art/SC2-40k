//--------------------------------------------------------------------------------------------------
// Trigger: Saturn Spawner
//--------------------------------------------------------------------------------------------------
bool gt_SaturnSpawner_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_spawner;
    point lv_point;
    string lv_research;
    string lv_research2;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_spawner = gv_saturn;
    lv_point = PointFromId(944123811);
    lv_research = "SaturnHUpgradeSpawn";
    lv_research2 = "SaturnXUpgradeSpawn";

    // Conditions
    if (testConds) {
        if (!((UnitIsAlive(lv_spawner) == true))) {
            return false;
        }

        if (!((PlayerGetPropertyInt(UnitGetOwner(lv_spawner), c_playerPropSuppliesUsed) <= PlayerGetPropertyInt(UnitGetOwner(lv_spawner), c_playerPropSuppliesMade)))) {
            return false;
        }

        if (!((UnitGetOwner(lv_spawner) != 0))) {
            return false;
        }

        if (!(((UnitGetOwner(lv_spawner) == gv_itemHighlord)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(0.25, c_timeGame);
    gf_CreateunitWraith(1, lv_spawner, lv_point);
    if (((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 4) || (TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research2, c_techCountCompleteOnly) >= 4))) {
        gf_CreateunitBattleCruiser(1, lv_spawner, lv_point);
        gf_CreateunitWraith(1, lv_spawner, lv_point);
    }

    if (((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 3) || (TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research2, c_techCountCompleteOnly) >= 3))) {
        gf_CreateunitBattleCruiser(1, lv_spawner, lv_point);
        gf_CreateunitWraith(1, lv_spawner, lv_point);
    }

    if (((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 2) || (TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research2, c_techCountCompleteOnly) >= 2))) {
        gf_CreateunitWraith(1, lv_spawner, lv_point);
    }

    if (((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 1) || (TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research2, c_techCountCompleteOnly) >= 1))) {
        gf_CreateunitWraith(1, lv_spawner, lv_point);
        gf_Createunit(1, "Skittari", lv_spawner, lv_point);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_SaturnSpawner_Init () {
    gt_SaturnSpawner = TriggerCreate("gt_SaturnSpawner_Func");
    TriggerEnable(gt_SaturnSpawner, false);
    TriggerAddEventTimePeriodic(gt_SaturnSpawner, 90.0, c_timeGame);
}

