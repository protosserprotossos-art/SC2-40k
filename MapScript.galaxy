    if ((libNtve_gf_TriggeringProgressUpgrade() == "WideReachOrdinance")) {
        gv_tier3ResearchAmount += 1;
        TriggerExecute(gt_TauResearchchecker, true, false);
    }

    if ((libNtve_gf_TriggeringProgressUpgrade() == "ShapersMight")) {
        gv_tier3ResearchAmount += 1;
        TriggerExecute(gt_TauResearchchecker, true, false);
    }

    if ((libNtve_gf_TriggeringProgressUpgrade() == "DirectivePrecisionAbsolute")) {
        gv_tier3ResearchAmount += 1;
        TriggerExecute(gt_TauResearchchecker, true, false);
    }

    if ((libNtve_gf_TriggeringProgressUpgrade() == "VoidborneTransit")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "ArbiterMP", c_unitCreateIgnorePlacement, gv_itemTau, PointFromId(2018632158));
