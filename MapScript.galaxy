//--------------------------------------------------------------------------------------------------
// Trigger: Tomb World Ice Heroes
//--------------------------------------------------------------------------------------------------
bool gt_TombWorldIceHeroes_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_spawner;
    point lv_point;
    string lv_research;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_spawner = gv_tombWorldIce;
    lv_point = PointFromId(592467746);
    lv_research = "TombWorldIceUpgradeSpawn";

    // Conditions
    if (testConds) {
        if (!((libNtve_gf_TriggeringProgressUpgrade() == lv_research))) {
            return false;
        }

        if (!((UnitIsAlive(lv_spawner) == true))) {
            return false;
        }

        if (!((EventUnit() == lv_spawner))) {
            return false;
        }

        if (!(((UnitGetOwner(EventUnit()) == gv_itemNecrons)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) == 3)) {
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) == 2)) {
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) == 1)) {
        gv_ctanShardsCompleted += 1;
        TriggerExecute(gt_NecronCtanShardSpawn, true, false);
    }

    return true;
}

