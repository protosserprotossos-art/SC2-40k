            libNtve_gf_RescueUnit(UnitLastCreated(), gv_itemWarringStates, true);
            gf_Createunitnosupply(1, "Marine", UnitFromId(1829183984), PointFromId(2035174599));
            UnitBehaviorAddPlayer(UnitLastCreated(), "ArtanisStasisField", 0, 1);
            UnitBehaviorAddPlayer(UnitLastCreated(), "VoidShade", 0, 1);
            libNtve_gf_RescueUnit(UnitLastCreated(), gv_itemWarringStates, true);
            gf_Createunitnosupply(1, "SpaceMarineTerminator", UnitFromId(1829183984), PointFromId(2035174599));
            UnitBehaviorAddPlayer(UnitLastCreated(), "ArtanisStasisField", 0, 1);
            UnitBehaviorAddPlayer(UnitLastCreated(), "VoidShade", 0, 1);
            libNtve_gf_RescueUnit(UnitLastCreated(), gv_itemWarringStates, true);
            gf_Createunitnosupply(1, "SpaceMarineTerminator", UnitFromId(1829183984), PointFromId(2035174599));
            UnitBehaviorAddPlayer(UnitLastCreated(), "ArtanisStasisField", 0, 1);
            UnitBehaviorAddPlayer(UnitLastCreated(), "VoidShade", 0, 1);
            libNtve_gf_RescueUnit(UnitLastCreated(), gv_itemWarringStates, true);
        }
        Wait(30.0, c_timeGame);
        gf_CreateunitHeroic("AlarakChampion", UnitFromId(1829183984), PointFromId(2035174599));
        gv_magnusTheRed = UnitLastCreated();
        UnitBehaviorAddPlayer(UnitLastCreated(), "ArtanisStasisField", 0, 1);
        UnitBehaviorAddPlayer(UnitLastCreated(), "VoidShade", 0, 1);
        TriggerEnable(gt_MagnusTheRedDeath, true);
    }

    return true;
}

