//--------------------------------------------------------------------------------------------------
// Trigger: Enable/disable buttons
//--------------------------------------------------------------------------------------------------
bool gt_Enabledisablebuttons_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_index;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    DialogSetVisible(gv_hotjoinDialogButton, PlayerGroupAll(), false);
    if ((gv_spectatorModeOn[gv_itemSpectator1] == true) && (gv_switchedOnce[gv_itemSpectator1] == false)) {
        DialogControlSetVisible(gv_hotjoinDialogButtonItem, PlayerGroupSingle(gv_itemSpectator1), true);
        DialogControlSetEnabled(gv_hotjoinDialogButtonItem, PlayerGroupSingle(gv_itemSpectator1), true);
        DialogSetVisible(gv_hotjoinDialogButton, PlayerGroupSingle(gv_itemSpectator1), true);
    }

    if ((gv_spectatorModeOn[gv_itemSpectator2] == true) && (gv_switchedOnce[gv_itemSpectator2] == false)) {
        DialogControlSetVisible(gv_hotjoinDialogButtonItem, PlayerGroupSingle(gv_itemSpectator2), true);
        DialogControlSetEnabled(gv_hotjoinDialogButtonItem, PlayerGroupSingle(gv_itemSpectator2), true);
        DialogSetVisible(gv_hotjoinDialogButton, PlayerGroupSingle(gv_itemSpectator2), true);
    }

    if ((gv_spectatorModeOn[gv_itemSpectator3] == true) && (gv_switchedOnce[gv_itemSpectator3] == false)) {
        DialogControlSetVisible(gv_hotjoinDialogButtonItem, PlayerGroupSingle(gv_itemSpectator3), true);
        DialogControlSetEnabled(gv_hotjoinDialogButtonItem, PlayerGroupSingle(gv_itemSpectator3), true);
        DialogSetVisible(gv_hotjoinDialogButton, PlayerGroupSingle(gv_itemSpectator3), true);
    }

    if ((UnitGroupCount(gv_highlordsStructures, c_unitCountAll) > 0) && (UnitIsAlive(gv_terra) == true) && ((gv_highlordsAIActive == true))) {
        DialogControlSetEnabled(gv_highlordsButton, PlayerGroupAll(), true);
    }
    else {
        DialogControlSetEnabled(gv_highlordsButton, PlayerGroupAll(), false);
    }
    if ((UnitGroupCount(gv_lionStructures, c_unitCountAll) > 0) && (UnitIsAlive(gv_terra) == true) && ((gv_lionAIActive == true))) {
        DialogControlSetEnabled(gv_lionButton, PlayerGroupAll(), true);
    }
    else {
        DialogControlSetEnabled(gv_lionButton, PlayerGroupAll(), false);
    }
    if ((UnitGroupCount(gv_robouteStructures, c_unitCountAll) > 0) && (UnitIsAlive(gv_terra) == true) && ((gv_robouteAIActive == true))) {
        DialogControlSetEnabled(gv_robouteButton, PlayerGroupAll(), true);
    }
    else {
        DialogControlSetEnabled(gv_robouteButton, PlayerGroupAll(), false);
    }
    if ((UnitGroupCount(gv_tauStructures, c_unitCountAll) > 0) && ((gv_tauAIActive == true))) {
        DialogControlSetEnabled(gv_tauButton, PlayerGroupAll(), true);
    }
    else {
        DialogControlSetEnabled(gv_tauButton, PlayerGroupAll(), false);
    }
    if ((UnitGroupCount(gv_necronStructures, c_unitCountAll) > 0) && ((gv_necronsAIActive == true))) {
        DialogControlSetEnabled(gv_necronButton, PlayerGroupAll(), true);
    }
    else {
        DialogControlSetEnabled(gv_necronButton, PlayerGroupAll(), false);
    }
    if ((UnitGroupCount(gv_leviathanStructures, c_unitCountAll) > 0) && ((gv_leviathanAIActive == true))) {
        DialogControlSetEnabled(gv_leviathanButton, PlayerGroupAll(), true);
    }
    else {
        DialogControlSetEnabled(gv_leviathanButton, PlayerGroupAll(), false);
    }
    if ((UnitGroupCount(gv_jorgumandrStructures, c_unitCountAll) > 0) && ((gv_jorgumandrAIActive == true))) {
        DialogControlSetEnabled(gv_jorgumandrButton, PlayerGroupAll(), true);
    }
    else {
        DialogControlSetEnabled(gv_jorgumandrButton, PlayerGroupAll(), false);
    }
    if ((UnitGroupCount(gv_krakenStructures, c_unitCountAll) > 0) && ((gv_krakenAIActive == true))) {
        DialogControlSetEnabled(gv_krakenButton, PlayerGroupAll(), true);
    }
    else {
        DialogControlSetEnabled(gv_krakenButton, PlayerGroupAll(), false);
    }
    return true;
}

