        gf_LoyaltyTauNecron(3, true);
        gf_LoyaltyTauImperium(3, true);
        gf_LoyaltyImperiumNecron(3, true);
    }

    if ((libNtve_gf_TriggeringProgressUpgrade() == "ShapersReflex")) {
        gv_tier1ResearchAmount += 1;
        TriggerExecute(gt_TauResearchchecker, true, false);
    }

