//--------------------------------------------------------------------------------------------------
bool gt_HolyTerraDeath_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_spawner;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_spawner = UnitFromId(1023264517);

    // Actions
    if (!runActions) {
        return true;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/8CC05C59"));
    UnitGroupRemove(gv_highlordsStructures, lv_spawner);
    UnitGroupRemove(gv_lionStructures, lv_spawner);
    UnitGroupRemove(gv_robouteStructures, lv_spawner);
    UnitGroupRemove(gv_warringStatesStructures, lv_spawner);
    gf_ClearRegionOfStatic(RegionFromId(50));
    Wait(30.0, c_timeGame);
    TriggerExecute(gt_Defeatcons, true, false);
    return true;
}

