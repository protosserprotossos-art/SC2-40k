//--------------------------------------------------------------------------------------------------
// Trigger: Form The Enclave Beacon
//--------------------------------------------------------------------------------------------------
bool gt_FormTheEnclaveBeacon_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_CreateUnitsWithDefaultFacing(1, "FormTheEnclaves", c_unitCreateIgnorePlacement, 0, PointFromId(1311222203));
    gv_formTheEnclaveBeacon = UnitLastCreated();
    TriggerEnable(gt_FormTheEnclaveActivate, true);
    Wait(720.0, c_timeGame);
    TriggerEnable(gt_FormTheEnclaveActivate, false);
    UnitKill(gv_formTheEnclaveBeacon);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_FormTheEnclaveBeacon_Init () {
    gt_FormTheEnclaveBeacon = TriggerCreate("gt_FormTheEnclaveBeacon_Func");
    TriggerAddEventTimeElapsed(gt_FormTheEnclaveBeacon, 720.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Form The Enclave Activate
//--------------------------------------------------------------------------------------------------
bool gt_FormTheEnclaveActivate_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == gv_itemTau))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) == "ImmortalTaldarim"))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeHeroic) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_ShowHideUnit(EventUnit(), false);
    libNtve_gf_RescueUnit(EventUnit(), 0, true);
    UnitKill(gv_formTheEnclaveBeacon);
    Wait(300.0, c_timeGame);
    libNtve_gf_ShowHideUnit(EventUnit(), true);
    libNtve_gf_RescueUnit(EventUnit(), gv_itemTau, true);
    UnitBehaviorAddPlayer(EventUnit(), "FounderOfTheFarSightEnclaves", 0, 1);
    libNtve_gf_SetUpgradeLevelForPlayer(gv_itemTau, "FarsightEnclavesFormed", 1);
    TriggerEnable(TriggerGetCurrent(), false);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/7951A613"));
    TriggerExecute(gt_UIUpdate, true, false);
    UnitKill(gv_formTheEnclaveBeacon);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_FormTheEnclaveActivate_Init () {
    gt_FormTheEnclaveActivate = TriggerCreate("gt_FormTheEnclaveActivate_Func");
    TriggerEnable(gt_FormTheEnclaveActivate, false);
    TriggerAddEventUnitRegion(gt_FormTheEnclaveActivate, null, RegionFromId(47), true);
}

