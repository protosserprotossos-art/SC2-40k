        gf_Createunit(1, "FlayedOne", lv_spawner, lv_point);
    }

    if ((gv_planetsPurified >= 16)) {
        gf_Createunit(1, "Destroyer", lv_spawner, lv_point);
        gf_Createunit(1, "FlayedOne", lv_spawner, lv_point);
    }

    if ((gv_planetsPurified >= 15)) {
        gf_Createunit(1, "NecronWraith", lv_spawner, lv_point);
        gf_Createunit(1, "NecronWarrior", lv_spawner, lv_point);
    }

    if ((gv_planetsPurified >= 14)) {
        gf_Createunit(1, "NecronWarrior", lv_spawner, lv_point);
        gf_Createunit(1, "FlayedOne", lv_spawner, lv_point);
    }

    if ((gv_planetsPurified >= 13)) {
        gf_Createunit(1, "NecronWarrior", lv_spawner, lv_point);
        gf_Createunit(1, "FlayedOne", lv_spawner, lv_point);
    }

    if ((gv_planetsPurified >= 12)) {
        gf_Createunit(1, "Destroyer", lv_spawner, lv_point);
        gf_Createunit(1, "FlayedOne", lv_spawner, lv_point);
    }

    if ((gv_planetsPurified >= 11)) {
        gf_Createunit(1, "NecronWraith", lv_spawner, lv_point);
        gf_Createunit(1, "NecronWarrior", lv_spawner, lv_point);
    }

    if ((gv_planetsPurified >= 10)) {
        gf_Createunit(1, "NecronWarrior", lv_spawner, lv_point);
        gf_Createunit(1, "FlayedOne", lv_spawner, lv_point);
    }

    if ((gv_planetsPurified >= 9)) {
        gf_Createunit(1, "NecronWarrior", lv_spawner, lv_point);
        gf_Createunit(1, "FlayedOne", lv_spawner, lv_point);
    }

    if ((gv_planetsPurified >= 8)) {
        gf_Createunit(1, "Destroyer", lv_spawner, lv_point);
        gf_Createunit(1, "FlayedOne", lv_spawner, lv_point);
    }

    if ((gv_planetsPurified >= 7)) {
        gf_Createunit(1, "NecronWraith", lv_spawner, lv_point);
