        }

        if (!(((UnitGetOwner(EventUnit()) == gv_itemLion)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) == 5)) {
        gf_CreateunitHeroic("SJHyperion", lv_spawner, lv_point);
        gv_battleship = UnitLastCreated();
        gf_AddSpawnerstostructuregroup(UnitLastCreated());
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) == 4)) {
