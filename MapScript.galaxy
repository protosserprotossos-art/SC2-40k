        gf_Createunitnosupply(5, "SpaceMarineTerminator", UnitFromId(1799516799), PointFromId(1821793235));
        gf_Createunitnosupply(5, "Marine", UnitFromId(1799516799), PointFromId(1821793235));
        UIDisplayMessage(PlayerGroupSingle(gv_itemLion), c_messageAreaSubtitle, StringExternal("Param/Value/79E0DD02"));
