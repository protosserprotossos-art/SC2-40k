        UnitIssueOrder(gv_tigrus, Order(AbilityCommand("TigrusUpgradeSpawn", 0)), c_orderQueueAddToEnd);
    }
    else if ((UnitGetOwner(gv_tau) == lv_player) && (TechTreeUpgradeCount(UnitGetOwner(gv_tau), "TauUpgradeSpawn", c_techCountCompleteOnly) < 5)) {
        UnitIssueOrder(gv_tau, Order(AbilityCommand("TauUpgradeSpawn", 0)), c_orderQueueAddToEnd);
    }
    return true;
}

