//--------------------------------------------------------------------------------------------------
// Trigger: Heretical Power (Change Stats)
//--------------------------------------------------------------------------------------------------
bool gt_HereticalPowerChangeStats_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_player;
    int lv_unitystacks;
    int lv_integer;

    // Automatic Variable Declarations
    const int autoB14A1B5A_ae = 20;
    const int autoB14A1B5A_ai = 1;

    // Variable Initialization
    lv_player = gv_itemWarringStates;
    lv_unitystacks = gv_unityStacksHighlord;

    // Actions
    if (!runActions) {
        return true;
    }

    lv_integer = 0;
    for ( ; ( (autoB14A1B5A_ai >= 0 && lv_integer <= autoB14A1B5A_ae) || (autoB14A1B5A_ai < 0 && lv_integer >= autoB14A1B5A_ae) ) ; lv_integer += autoB14A1B5A_ai ) {
        if ((lv_unitystacks == lv_integer)) {
            libNtve_gf_SetUpgradeLevelForPlayer(lv_player, "UnityStacks", gv_hereticalPowerStacks);
        }

    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_HereticalPowerChangeStats_Init () {
    gt_HereticalPowerChangeStats = TriggerCreate("gt_HereticalPowerChangeStats_Func");
    TriggerAddEventTimeElapsed(gt_HereticalPowerChangeStats, 5.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Reduce Devouring Hunger
//--------------------------------------------------------------------------------------------------
bool gt_ReduceDevouringHunger_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_devouringHungerStacksLeviathan > 0)) {
        gv_devouringHungerStacksLeviathan -= 1;
        TriggerExecute(gt_DevouringHungerUILeviathan, true, false);
        TriggerExecute(gt_DevouringHungerChangeStatsLeviathan, true, false);
        gf_ImmortalCheckGlobal(gv_itemLeviathan);
    }

    if ((gv_devouringHungerStacksJorgumandr > 0)) {
        gv_devouringHungerStacksJorgumandr -= 1;
        TriggerExecute(gt_DevouringHungerUIJorgumandr, true, false);
        TriggerExecute(gt_DevouringHungerChangeStatsJorgumandr, true, false);
        gf_ImmortalCheckGlobal(gv_itemJorgumandr);
    }

    if ((gv_devouringHungerStacksKraken > 0)) {
        gv_devouringHungerStacksKraken -= 1;
        TriggerExecute(gt_DevouringHungerUIKraken, true, false);
        TriggerExecute(gt_DevouringHungerChangeStatsKraken, true, false);
        gf_ImmortalCheckGlobal(gv_itemKraken);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
