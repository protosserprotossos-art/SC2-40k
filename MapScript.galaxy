void gf_AddSpawnerstostructuregroup (unit lp_spawner) {
    // Automatic Variable Declarations
    // Implementation
    if ((UnitGetOwner(lp_spawner) == gv_itemHighlord)) {
        UnitGroupAdd(gv_highlordsStructures, lp_spawner);
    }

    if ((UnitGetOwner(lp_spawner) == gv_itemLion)) {
        UnitGroupAdd(gv_lionStructures, lp_spawner);
    }

    if ((UnitGetOwner(lp_spawner) == gv_itemRoboute)) {
        UnitGroupAdd(gv_robouteStructures, lp_spawner);
    }

    if ((UnitGetOwner(lp_spawner) == gv_itemTau)) {
        UnitGroupAdd(gv_tauStructures, lp_spawner);
    }

    if ((UnitGetOwner(lp_spawner) == gv_itemNecrons)) {
        UnitGroupAdd(gv_necronStructures, lp_spawner);
    }

    if ((UnitGetOwner(lp_spawner) == gv_itemLeviathan)) {
        UnitGroupAdd(gv_leviathanStructures, lp_spawner);
    }

    if ((UnitGetOwner(lp_spawner) == gv_itemJorgumandr)) {
        UnitGroupAdd(gv_jorgumandrStructures, lp_spawner);
    }

    if ((UnitGetOwner(lp_spawner) == gv_itemKraken)) {
        UnitGroupAdd(gv_krakenStructures, lp_spawner);
    }

    if ((UnitGetOwner(lp_spawner) == gv_itemWarringStates)) {
        UnitGroupAdd(gv_warringStatesStructures, lp_spawner);
    }

}

