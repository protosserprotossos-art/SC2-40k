int gf_OwnerOfAttackingUnitItemBound (unit lp_attackingUnit) {
    // Automatic Variable Declarations
    // Implementation
    if ((UnitGetOwner(lp_attackingUnit) == UnitGetOwner(UnitFromId(490755046)))) {
        return gv_itemHighlord;
    }
    else if ((UnitGetOwner(lp_attackingUnit) == UnitGetOwner(UnitFromId(1799516799)))) {
        return gv_itemLion;
    }
    else if ((UnitGetOwner(lp_attackingUnit) == UnitGetOwner(UnitFromId(1797122141)))) {
        return gv_itemRoboute;
    }
    else if ((UnitGetOwner(lp_attackingUnit) == UnitGetOwner(UnitFromId(2128247628)))) {
        return gv_itemTau;
    }
    else if ((UnitGetOwner(lp_attackingUnit) == UnitGetOwner(UnitFromId(959896214)))) {
        return gv_itemNecrons;
    }
    else if ((UnitGetOwner(lp_attackingUnit) == UnitGetOwner(UnitFromId(1775627665)))) {
        return gv_itemLeviathan;
    }
    else if ((UnitGetOwner(lp_attackingUnit) == UnitGetOwner(UnitFromId(60074446)))) {
        return gv_itemJorgumandr;
    }
    else if ((UnitGetOwner(lp_attackingUnit) == UnitGetOwner(UnitFromId(149392864)))) {
        return gv_itemKraken;
    }
    else if ((UnitGetOwner(lp_attackingUnit) == UnitGetOwner(UnitFromId(1829183984)))) {
        return gv_itemWarringStates;
    }
    return 0;
}

