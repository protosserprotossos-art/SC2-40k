bool gt_DevSpectator_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_playerItemValueInteger;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((gf_Developer(EventPlayer()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_playerItemValueInteger = StringToInt(StringSub(EventChatMessage(false), 11, StringLength(EventChatMessage(false))));
    if ((gf_PlayerValueexists(lv_playerItemValueInteger) == true)) {
        gf_TurnPlayerIntoSpectator(lv_playerItemValueInteger);
        UIDisplayMessage(PlayerGroupSingle(EventPlayer()), c_messageAreaSubtitle, StringExternal("Param/Value/66DEB3CD"));
    }
    else {
        UIDisplayMessage(PlayerGroupSingle(EventPlayer()), c_messageAreaSubtitle, StringExternal("Param/Value/FADDBF6F"));
    }
    return true;
}

