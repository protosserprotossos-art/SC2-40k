//--------------------------------------------------------------------------------------------------
// Trigger: Region Move Caller
//--------------------------------------------------------------------------------------------------
bool gt_RegionMoveCaller_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    gf_RegionMove(gv_itemHighlord, gv_heroicGroupIndexHighlords, gv_heroicGroupHighlords, gv_highlordAIGroup, gv_highlordArbiter, gv_highlordsAIActive);
    gf_RegionMove(gv_itemLion, gv_heroicGroupIndexLion, gv_heroicGroupLion, gv_lionAIGroup, gv_lionArbiter, gv_lionAIActive);
    gf_RegionMove(gv_itemRoboute, gv_heroicGroupIndexRoboute, gv_heroicGroupRoboute, gv_robouteAIGroup, gv_robouteArbiter, gv_robouteAIActive);
    gf_RegionMove(gv_itemTau, gv_heroicGroupIndexTau, gv_heroicGroupTau, gv_tauAIGroup, gv_tauArbiter, gv_tauAIActive);
    gf_RegionMove(gv_itemNecrons, gv_heroicGroupIndexNecrons, gv_heroicGroupNecrons, gv_necronsAIGroup, gv_necronArbiter, gv_necronsAIActive);
    gf_RegionMove(gv_itemLeviathan, gv_heroicGroupIndexLeviathan, gv_heroicGroupLeviathan, gv_leviathanAIGroup, gv_leviathanArbiter, gv_leviathanAIActive);
    gf_RegionMove(gv_itemJorgumandr, gv_heroicGroupIndexJorgumandr, gv_heroicGroupJorgumandr, gv_jorgumandrAIGroup, gv_jorgumandrArbiter, gv_jorgumandrAIActive);
    gf_RegionMove(gv_itemKraken, gv_heroicGroupIndexKraken, gv_heroicGroupKraken, gv_krakenAIGroup, gv_krakenArbiter, gv_krakenAIActive);
    return true;
}

