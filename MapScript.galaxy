//--------------------------------------------------------------------------------------------------
// Trigger: Spawn Timer
//--------------------------------------------------------------------------------------------------
bool gt_SpawnTimer_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TimerStart(gv_t, 90.0, true, c_timeGame);
    TimerWindowCreate(TimerLastStarted(), StringExternal("Param/Value/4E203E02"), true, false);
    gv_tW = TimerWindowLastCreated();
    Wait(1.0, c_timeGame);
    TimerWindowSetStyle(gv_tW, c_timerWindowStyleHorizontalTitleTime, false);
    TimerWindowShowBorder(gv_tW, true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_SpawnTimer_Init () {
    gt_SpawnTimer = TriggerCreate("gt_SpawnTimer_Func");
    TriggerAddEventMapInit(gt_SpawnTimer);
}

//--------------------------------------------------------------------------------------------------
// Trigger: reveal map
//--------------------------------------------------------------------------------------------------
bool gt_revealmap_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_player;

    // Automatic Variable Declarations
    playergroup auto5EB57808_g;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    auto5EB57808_g = PlayerGroupAll();
    lv_player = -1;
    while (true) {
        lv_player = PlayerGroupNextPlayer(auto5EB57808_g, lv_player);
        if (lv_player < 0) { break; }
        VisRevealArea(lv_player, RegionPlayableMap(), 0.01, true);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_revealmap_Init () {
    gt_revealmap = TriggerCreate("gt_revealmap_Func");
    TriggerAddEventMapInit(gt_revealmap);
}

