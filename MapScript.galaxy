    gt_InviteRobouteToTerraActivate = TriggerCreate("gt_InviteRobouteToTerraActivate_Func");
    TriggerEnable(gt_InviteRobouteToTerraActivate, false);
    TriggerAddEventUnitRegion(gt_InviteRobouteToTerraActivate, null, RegionFromId(51), true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Constantin Valdors start Hints
//--------------------------------------------------------------------------------------------------
bool gt_ConstantinValdorsstartHints_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_integer;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    UIDisplayMessage(PlayerGroupSingle(gv_itemRoboute), c_messageAreaSubtitle, StringExternal("Param/Value/CD36BAB4"));
    TriggerEnable(gt_ConstantinValdorBeaconActivations, true);
    gv_constantinValdorCluesRegionsArray[1] = RegionFromId(52);
    gv_constantinValdorCluesRegionsArray[2] = RegionFromId(53);
    gv_constantinValdorCluesRegionsArray[3] = RegionFromId(54);
    gv_constantinValdorCluesRegionsArray[4] = RegionFromId(55);
    gv_constantinValdorCluesRegionsArray[5] = RegionFromId(56);
    gv_constantinValdorCluesRegionsArray[6] = RegionFromId(57);
    gv_constantinValdorCluesRegionsArray[7] = RegionFromId(58);
    while ((gv_constantinValdorCluesHintsCreated < 4)) {
        Wait(1.0, c_timeGame);
        if ((RandomInt(1, 2) == 1) && (gv_constantinValdorCluesActivatedArray[1] == false)) {
            gv_constantinValdorCluesHintsCreated += 1;
            gv_constantinValdorCluesActivatedArray[1] = true;
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "ConstantinValdorClue", c_unitCreateIgnorePlacement, 0, PointFromId(491640751));
            gv_constantinValdorCluesBeaconsArray[1] = UnitLastCreated();
        }
        else if ((RandomInt(1, 2) == 1) && (gv_constantinValdorCluesActivatedArray[2] == false)) {
            gv_constantinValdorCluesHintsCreated += 1;
            gv_constantinValdorCluesActivatedArray[2] = true;
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "ConstantinValdorClue", c_unitCreateIgnorePlacement, 0, PointFromId(1311682733));
            gv_constantinValdorCluesBeaconsArray[2] = UnitLastCreated();
        }
        else if ((RandomInt(1, 2) == 1) && (gv_constantinValdorCluesActivatedArray[3] == false)) {
            gv_constantinValdorCluesHintsCreated += 1;
            gv_constantinValdorCluesActivatedArray[3] = true;
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "ConstantinValdorClue", c_unitCreateIgnorePlacement, 0, PointFromId(605430089));
            gv_constantinValdorCluesBeaconsArray[3] = UnitLastCreated();
        }
        else if ((RandomInt(1, 2) == 1) && (gv_constantinValdorCluesActivatedArray[4] == false)) {
            gv_constantinValdorCluesHintsCreated += 1;
            gv_constantinValdorCluesActivatedArray[4] = true;
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "ConstantinValdorClue", c_unitCreateIgnorePlacement, 0, PointFromId(236600805));
            gv_constantinValdorCluesBeaconsArray[4] = UnitLastCreated();
        }
        else if ((RandomInt(1, 2) == 1) && (gv_constantinValdorCluesActivatedArray[5] == false)) {
            gv_constantinValdorCluesHintsCreated += 1;
            gv_constantinValdorCluesActivatedArray[5] = true;
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "ConstantinValdorClue", c_unitCreateIgnorePlacement, 0, PointFromId(102275543));
            gv_constantinValdorCluesBeaconsArray[5] = UnitLastCreated();
        }
        else if ((RandomInt(1, 2) == 1) && (gv_constantinValdorCluesActivatedArray[6] == false)) {
            gv_constantinValdorCluesHintsCreated += 1;
            gv_constantinValdorCluesActivatedArray[6] = true;
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "ConstantinValdorClue", c_unitCreateIgnorePlacement, 0, PointFromId(190049195));
            gv_constantinValdorCluesBeaconsArray[6] = UnitLastCreated();
        }
