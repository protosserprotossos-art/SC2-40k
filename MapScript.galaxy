//--------------------------------------------------------------------------------------------------
// Trigger: Bellus Prime (Imperium)
//--------------------------------------------------------------------------------------------------
bool gt_BellusPrimeImperium_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_spawner;
    point lv_point;
    string lv_research;
    string lv_retreatUpgrade;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_spawner = gv_bellusPrime;
    lv_point = PointFromId(1821793235);
    lv_research = "BellusPrimeUpgradeSpawn";
    lv_retreatUpgrade = "RetreatBellusPrime";

    // Conditions
    if (testConds) {
        if (!((UnitIsAlive(lv_spawner) == true))) {
            return false;
        }

        if (!((PlayerGetPropertyInt(UnitGetOwner(lv_spawner), c_playerPropSuppliesUsed) <= PlayerGetPropertyInt(UnitGetOwner(lv_spawner), c_playerPropSuppliesMade)))) {
            return false;
        }

        if (!((UnitGetOwner(lv_spawner) != 0))) {
            return false;
        }

        if (!(((UnitGetOwner(lv_spawner) == gv_itemHighlord) || (UnitGetOwner(lv_spawner) == gv_itemLion) || (UnitGetOwner(lv_spawner) == gv_itemRoboute) || (UnitGetOwner(lv_spawner) == gv_itemWarringStates)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(0.25, c_timeGame);
    gf_AISpawnerResearchTauChaos(lv_spawner, lv_point, "AIresearch");
    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 4)) {
        gf_Createunit(1, "Marine", lv_spawner, lv_point);
        gf_CreateunitMeleeAlternatives(1, lv_spawner, lv_point);
        gf_Createunit(2, "Separatist", lv_spawner, lv_point);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 3)) {
        gf_Createunit(1, "SiegeTank", lv_spawner, lv_point);
        gf_Createunit(1, "VikingAssault", lv_spawner, lv_point);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 2)) {
        gf_Createunit(1, "Goliath", lv_spawner, lv_point);
        gf_Createunit(1, "VikingAssault", lv_spawner, lv_point);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 1) && (TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_retreatUpgrade, c_techCountCompleteOnly) != 1)) {
        gf_CreateunitMeleeAlternatives(1, lv_spawner, lv_point);
        gf_Createunit(1, "Goliath", lv_spawner, lv_point);
    }

    if ((TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_research, c_techCountCompleteOnly) >= 0) && (TechTreeUpgradeCount(UnitGetOwner(lv_spawner), lv_retreatUpgrade, c_techCountCompleteOnly) != 1)) {
        gf_Createunit(1, "Goliath", lv_spawner, lv_point);
        gf_Createunit(1, "Separatist", lv_spawner, lv_point);
    }

    return true;
}

