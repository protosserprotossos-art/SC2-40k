    if ((UnitGetOwner(EventUnit()) == gv_itemTau)) {
        gv_enclaveCivilWarActivated = true;
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "TauEnclaveCivilWar", 1);
        gf_SpawnTau(UnitFromId(172819595), 3, false);
        libNtve_gf_RescueUnit(UnitFromId(1508605938), 10, true);
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/8AE0D1B5"));
    }

    UnitBehaviorAddPlayer(gv_commanderFarsight, "HeroOfTheFarSightEnclaves", 0, 1);
    return true;
}

