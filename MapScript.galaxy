//--------------------------------------------------------------------------------------------------
// Trigger: Propaganda
//--------------------------------------------------------------------------------------------------
bool gt_Propaganda_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventUnitAbility() == AbilityCommand("PropagandaAgainstTheNecrons", 0))) {
        if ((UnitGetOwner(EventUnit()) == gv_itemHighlord)) {
            gv_unityStacksHighlord += 1;
        }

        if ((UnitGetOwner(EventUnit()) == gv_itemLion)) {
            gv_unityStacksLion += 1;
        }

        if ((UnitGetOwner(EventUnit()) == gv_itemRoboute)) {
            gv_unityStacksRoboute += 1;
        }

        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "PropagandaAgainstTheNecrons", 1);
        gf_LoyaltyImperiumNecron(20, false);
        TriggerExecute(gt_UnityUIRoboute, true, false);
        TriggerExecute(gt_UnityUILion, true, false);
        TriggerExecute(gt_UnityUIHighlords, true, false);
        TriggerExecute(gt_UnityChangeStatsRoboute, true, false);
        TriggerExecute(gt_UnityChangeStatsLion, true, false);
        TriggerExecute(gt_UnityChangeStatsHighlord, true, false);
    }

    if ((EventUnitAbility() == AbilityCommand("PropagandaAgainstTheTau", 0))) {
        if ((UnitGetOwner(EventUnit()) == gv_itemHighlord)) {
            gv_unityStacksHighlord += 1;
        }

        if ((UnitGetOwner(EventUnit()) == gv_itemLion)) {
            gv_unityStacksLion += 1;
        }

        if ((UnitGetOwner(EventUnit()) == gv_itemRoboute)) {
            gv_unityStacksRoboute += 1;
        }

        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "PropagandaAgainstTheTau", 1);
        gf_LoyaltyTauImperium(20, false);
        TriggerExecute(gt_UnityUIRoboute, true, false);
        TriggerExecute(gt_UnityUILion, true, false);
        TriggerExecute(gt_UnityUIHighlords, true, false);
        TriggerExecute(gt_UnityChangeStatsRoboute, true, false);
        TriggerExecute(gt_UnityChangeStatsLion, true, false);
        TriggerExecute(gt_UnityChangeStatsHighlord, true, false);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Propaganda_Init () {
    gt_Propaganda = TriggerCreate("gt_Propaganda_Func");
    TriggerAddEventUnitAbility(gt_Propaganda, null, AbilityCommand("PropagandaAgainstTheNecrons", 0), c_unitAbilStageComplete, false);
    TriggerAddEventUnitAbility(gt_Propaganda, null, AbilityCommand("PropagandaAgainstTheTau", 0), c_unitAbilStageComplete, false);
}

