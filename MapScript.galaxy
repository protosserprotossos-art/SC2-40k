bool gt_UncrownedMonarchConditions_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((libNtve_gf_UnitGetPropertyKills(EventUnit(), c_unitPropCurrent) >= 99))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) == "RaynorLab"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_uncrownedMonarchConditionsfulfilled = true;
    return true;
}

