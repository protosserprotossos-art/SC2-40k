    lv_tombWorld = UnitLastCreated();
    TriggerEnable(gt_TombWorldIceNecron, true);
    gf_AddSpawnerstostructuregroup(lv_tombWorld);
    gf_LoyaltyTauNecron(5, false);
    gf_LoyaltyImperiumNecron(5, false);
    gv_tombWorldIce = lv_tombWorld;
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "NecronFortificaiton", c_unitCreateIgnorePlacement, 0, PointFromId(1210109582));
    UnitBehaviorAddPlayer(UnitLastCreated(), "ArtanisStasisField", 0, 1);
    libNtve_gf_RescueUnit(UnitLastCreated(), UnitGetOwner(EventUnit()), true);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "NecronFortificaiton", c_unitCreateIgnorePlacement, 0, PointFromId(382716721));
    UnitBehaviorAddPlayer(UnitLastCreated(), "ArtanisStasisField", 0, 1);
    libNtve_gf_RescueUnit(UnitLastCreated(), UnitGetOwner(EventUnit()), true);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "NecronFortificaiton", c_unitCreateIgnorePlacement, 0, PointFromId(309083767));
    UnitBehaviorAddPlayer(UnitLastCreated(), "ArtanisStasisField", 0, 1);
    libNtve_gf_RescueUnit(UnitLastCreated(), UnitGetOwner(EventUnit()), true);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "NecronFortificaiton", c_unitCreateIgnorePlacement, 0, PointFromId(929717063));
    UnitBehaviorAddPlayer(UnitLastCreated(), "ArtanisStasisField", 0, 1);
    libNtve_gf_RescueUnit(UnitLastCreated(), UnitGetOwner(EventUnit()), true);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "NecronFortificaiton", c_unitCreateIgnorePlacement, 0, PointFromId(878228574));
    UnitBehaviorAddPlayer(UnitLastCreated(), "ArtanisStasisField", 0, 1);
    libNtve_gf_RescueUnit(UnitLastCreated(), UnitGetOwner(EventUnit()), true);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "NecronFortificaiton", c_unitCreateIgnorePlacement, 0, PointFromId(143934268));
    UnitBehaviorAddPlayer(UnitLastCreated(), "ArtanisStasisField", 0, 1);
    libNtve_gf_RescueUnit(UnitLastCreated(), UnitGetOwner(EventUnit()), true);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "NecronFortificaiton", c_unitCreateIgnorePlacement, 0, PointFromId(1198545086));
    UnitBehaviorAddPlayer(UnitLastCreated(), "ArtanisStasisField", 0, 1);
    libNtve_gf_RescueUnit(UnitLastCreated(), UnitGetOwner(EventUnit()), true);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "KhaydarinMonolith", c_unitCreateIgnorePlacement, 0, PointFromId(342876845));
    UnitBehaviorAddPlayer(UnitLastCreated(), "ArtanisStasisField", 0, 1);
    libNtve_gf_RescueUnit(UnitLastCreated(), UnitGetOwner(EventUnit()), true);
