        UIDisplayMessage(PlayerGroupSingle(gv_itemLion), c_messageAreaSubtitle, StringExternal("Param/Value/EE9247C0"));
        TriggerExecute(gt_FallenAngelsDestroyBeacons, true, false);
    }

    if ((EventUnitRegion() == RegionFromId(80)) && (gv_fallenAngelsBeaconActivated[5] == false)) {
        gv_fallenAngelsbeaconscompleted += 1;
