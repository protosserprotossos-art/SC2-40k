    gt_TriggerUncrownedMonarch = TriggerCreate("gt_TriggerUncrownedMonarch_Func");
    TriggerAddEventUnitDied(gt_TriggerUncrownedMonarch, UnitRefFromVariable("gv_robouteGuiliman"));
}

