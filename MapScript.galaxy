//--------------------------------------------------------------------------------------------------
// Trigger: RockNRoll Soundtrack
//--------------------------------------------------------------------------------------------------
bool gt_RockNRollSoundtrack_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_index;

    // Automatic Variable Declarations
    const int autoDE08AA12_ae = gv_numberOfPlayers;
    const int autoDE08AA12_ai = 1;

    // Variable Initialization
    lv_index = 1;

    // Actions
    if (!runActions) {
        return true;
    }

    SoundChannelMute(PlayerGroupAll(), c_soundCategoryMusic, true);
    Wait(0.75, c_timeGame);
    lv_index = 1;
    for ( ; ( (autoDE08AA12_ai >= 0 && lv_index <= autoDE08AA12_ae) || (autoDE08AA12_ai < 0 && lv_index >= autoDE08AA12_ae) ) ; lv_index += autoDE08AA12_ai ) {
        SoundtrackPlay(PlayerGroupSingle(lv_index), c_soundtrackCategoryMusic, "RockNRollSoundtrack", c_soundtrackCueAny, c_soundtrackIndexAny, false);
    }
    SoundChannelMute(PlayerGroupAll(), c_soundCategoryMusic, false);
    Wait(500.0, c_timeGame);
    TriggerExecute(gt_Soundtrack, true, false);
    return true;
}

