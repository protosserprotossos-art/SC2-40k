//--------------------------------------------------------------------------------------------------
bool gt_StarttimerNecrontryingtosoftlock_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TimerStart(gv_necronsoftlocktimer, 60.0, false, c_timeGame);
    if ((gv_necrondynastictipdone == false)) {
        UIDisplayMessage(PlayerGroupSingle(gv_itemNecrons), c_messageAreaSubtitle, StringExternal("Param/Value/97E8F64B"));
        gv_necrondynastictipdone = true;
    }

    return true;
}

