void gt_TauImperiumTemoraryWar_Init () {
    gt_TauImperiumTemoraryWar = TriggerCreate("gt_TauImperiumTemoraryWar_Func");
    TriggerAddEventUnitAbility(gt_TauImperiumTemoraryWar, null, AbilityCommand("TauImperiumTemoraryWar", 0), c_unitAbilStageComplete, false);
}

