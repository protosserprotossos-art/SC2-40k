bool gt_TrazynBlink_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_lifeStart;
    int lv_shieldsStart;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    lv_lifeStart = UnitGetPropertyInt(EventUnit(), c_unitPropLife, c_unitPropCurrent);
    lv_shieldsStart = UnitGetPropertyInt(EventUnit(), c_unitPropShields, c_unitPropCurrent);
    Wait(3.0, c_timeGame);
    if ((UnitIsAlive(EventUnit()) == true)) {
        UnitSetPropertyFixed(EventUnit(), c_unitPropLife, lv_lifeStart);
        UnitSetPropertyFixed(EventUnit(), c_unitPropShields, lv_shieldsStart);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_TrazynBlink_Init () {
    gt_TrazynBlink = TriggerCreate("gt_TrazynBlink_Func");
    TriggerAddEventUnitAbility(gt_TrazynBlink, null, AbilityCommand("TrazynTimeTwister", 0), c_unitAbilStageExecute, false);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Genestealer Broodmother Aura
//--------------------------------------------------------------------------------------------------
bool gt_GenestealerBroodmotherAura_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((RandomInt(1, 10) <= 5))) {
            return false;
        }

        if (!((UnitBehaviorCount(libNtve_gf_KillingUnit(), "BroodmotherGenestealerAuraApply") == 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_CreateUnitsWithDefaultFacing(1, "InfestedCivilian", 0, UnitGetOwner(libNtve_gf_KillingUnit()), UnitGetPosition(EventUnit()));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_GenestealerBroodmotherAura_Init () {
    gt_GenestealerBroodmotherAura = TriggerCreate("gt_GenestealerBroodmotherAura_Func");
    TriggerEnable(gt_GenestealerBroodmotherAura, false);
    TriggerAddEventUnitDied(gt_GenestealerBroodmotherAura, null);
}

