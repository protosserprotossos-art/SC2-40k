//--------------------------------------------------------------------------------------------------
bool gt_OpenBridge_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_blocker;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_blocker = UnitFromId(567542906);

    // Conditions
    if (testConds) {
        if (!((RandomInt(1, 10) <= 8))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitKill(lv_blocker);
    ActorSend(ActorFromDoodad(gv_bridgeOpenHolder), libNtve_gf_SetVisibility(true));
    ActorSend(ActorFromDoodad(gv_bridgeClosedHolder), libNtve_gf_SetVisibility(false));
    return true;
}

