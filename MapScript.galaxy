void gf_GrantAchivement (int lp_player, string lp_achivementKeyName, text lp_achivementRankName, text lp_achivementDescription, int lp_achivementPoints, string lp_achivementImage, int lp_achivementDialogIndex, int lp_achivementIndex) {
    // Variable Declarations
    string lv_bank;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_bank = gv_bankName;

    // Implementation
    if ((gf_PlayerisnotAI(lp_player) == false) && (PlayerType(lp_player) == c_playerTypeUser) && (BankKeyExists(gv_bank[lp_player], "achievements", lp_achivementKeyName) == false)) {
        BankValueSetFromFlag(gv_bank[lp_player], "achievements", lp_achivementKeyName, true);
        BankSave(gv_bank[lp_player]);
        DialogControlSetEnabled(lp_achivementDialogIndex, PlayerGroupSingle(lp_player), true);
        lib1_gf_AchievementActivate(lp_achivementIndex, lp_player, lp_achivementRankName, lp_achivementDescription, lp_achivementPoints, lp_achivementImage);
    }

}

void gf_OpenAchivement (int lp_player, string lp_achivementKeyName, int lp_achivementIndex, int lp_points) {
    // Variable Declarations
    string lv_bank;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_bank = gv_bankName;

    // Implementation
    if ((PlayerType(lp_player) == c_playerTypeUser) && (BankKeyExists(gv_bank[lp_player], "achievements", lp_achivementKeyName) == true)) {
        DialogControlSetEnabled(lp_achivementIndex, PlayerGroupSingle(lp_player), true);
    }
}

void gf_BankErrormessage () {
    // Automatic Variable Declarations
    // Implementation
    libNtve_gf_UIErrorMessage(PlayerGroupAll(), StringExternal("Param/Value/B13E904B"), SoundLink("AbathurA_BuildError", -1));
}

void gf_SpawnerOptimization (int lp_player, trigger lp_trigger1Tyranid, trigger lp_trigger2Imperium, trigger lp_trigger3Necrons, trigger lp_trigger4Tau) {
    // Automatic Variable Declarations
    // Implementation
    TriggerEnable(lp_trigger1Tyranid, false);
    TriggerEnable(lp_trigger2Imperium, false);
    TriggerEnable(lp_trigger3Necrons, false);
    TriggerEnable(lp_trigger4Tau, false);
    if (((lp_player == gv_itemKraken) || (lp_player == gv_itemJorgumandr) || (lp_player == gv_itemLeviathan))) {
        TriggerEnable(lp_trigger1Tyranid, true);
    }
    else if (((lp_player == gv_itemHighlord) || (lp_player == gv_itemLion) || (lp_player == gv_itemHighlord) || (lp_player == gv_itemWarringStates))) {
        TriggerEnable(lp_trigger2Imperium, true);
    }
    else if ((lp_player == gv_itemNecrons)) {
        TriggerEnable(lp_trigger3Necrons, true);
    }
    else if ((lp_player == gv_itemTau)) {
        TriggerEnable(lp_trigger4Tau, true);
    }
}

void gf_Acceleratedeaccelerateupgrades (unit lp_spawner, int lp_player) {
    // Automatic Variable Declarations
    // Implementation
    if ((lp_player == gv_itemKraken)) {
        UnitBehaviorAdd(lp_spawner, "AcceleratedUpgrades", UnitFromId(149392864), 1);
    }
    else {
        UnitBehaviorRemove(lp_spawner, "AcceleratedUpgrades", 1);
    }
}

void gf_HotjoinCleanupTurnintoplayer (int lp_triggeringPlayer) {
    // Automatic Variable Declarations
    // Implementation
    VisRevealerDestroy(gv_revealer[lp_triggeringPlayer]);
    PlayerModifyPropertyInt(lp_triggeringPlayer, c_playerPropSuppliesMade, c_playerPropOperSetTo, 0);
    PlayerModifyPropertyInt(lp_triggeringPlayer, c_playerPropVespene, c_playerPropOperSetTo, 0);
    PlayerModifyPropertyInt(lp_triggeringPlayer, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 500);
    if ((lp_triggeringPlayer == gv_itemHighlord)) {
        gv_highlordsDefeated = true;
        VisRevealerDestroy(gv_revealer[gv_itemHighlord]);
        gv_itemHighlord = gv_originalHighlordItemValue;
    }

    if ((lp_triggeringPlayer == gv_itemLion)) {
        gv_lionDefeated = true;
        VisRevealerDestroy(gv_revealer[gv_itemLion]);
        gv_itemLion = gv_originalLionItemValue;
    }

    if ((lp_triggeringPlayer == gv_itemRoboute)) {
        gv_robouteDefeated = true;
        VisRevealerDestroy(gv_revealer[gv_itemRoboute]);
        gv_itemRoboute = gv_originalRobouteItemValue;
    }

    if ((lp_triggeringPlayer == gv_itemTau)) {
        gv_tauDefeated = true;
        VisRevealerDestroy(gv_revealer[gv_itemTau]);
        gv_itemTau = gv_originalTauItemValue;
    }

    if ((lp_triggeringPlayer == gv_itemNecrons)) {
        gv_necronDefeated = true;
        VisRevealerDestroy(gv_revealer[gv_itemNecrons]);
        gv_itemNecrons = gv_originalNecronsItemValue;
    }

    if ((lp_triggeringPlayer == gv_itemLeviathan)) {
        gv_leviathanDefeated = true;
        VisRevealerDestroy(gv_revealer[gv_itemLeviathan]);
        gv_itemLeviathan = gv_originalLeviathanItemValue;
    }

    if ((lp_triggeringPlayer == gv_itemJorgumandr)) {
        gv_jorgumandrDefeated = true;
        VisRevealerDestroy(gv_revealer[gv_itemJorgumandr]);
        gv_itemJorgumandr = gv_originalJorgumandrItemValue;
    }

    if ((lp_triggeringPlayer == gv_itemKraken)) {
        gv_krakenDefeated = true;
        VisRevealerDestroy(gv_revealer[gv_itemKraken]);
        gv_itemKraken = gv_originalKrakenItemValue;
    }

}

