//--------------------------------------------------------------------------------------------------
// Trigger: AI Checker
//--------------------------------------------------------------------------------------------------
bool gt_AIChecker_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((PlayerType(gv_itemHighlord) == c_playerTypeComputer)) {
        gv_highlordsAIActive = true;
        TriggerEnable(gt_InviteRobouteToTerraAI, true);
        TriggerEnable(gt_RandomizePropaganda, true);
        TriggerEnable(gt_RandomizeCivilWarImperium, true);
        gv_humanPlayers -= 1;
    }

    if ((PlayerType(gv_itemLion) == c_playerTypeComputer)) {
        gv_lionAIActive = true;
        TriggerEnable(gt_RandomizePropaganda, true);
        TriggerEnable(gt_RandomizeCivilWarImperium, true);
        gv_humanPlayers -= 1;
    }

    if ((PlayerType(gv_itemRoboute) == c_playerTypeComputer)) {
        gv_robouteAIActive = true;
        TriggerEnable(gt_RandomizePropaganda, true);
        TriggerEnable(gt_RandomizeCivilWarImperium, true);
        gv_humanPlayers -= 1;
    }

    if ((PlayerType(gv_itemTau) == c_playerTypeComputer)) {
        gv_tauAIActive = true;
        gv_humanPlayers -= 1;
    }

    if ((PlayerType(gv_itemNecrons) == c_playerTypeComputer)) {
        gv_necronsAIActive = true;
        TriggerExecute(gt_Necronsstartmove, true, false);
        gv_humanPlayers -= 1;
    }

    if ((PlayerType(gv_itemLeviathan) == c_playerTypeComputer)) {
        gv_leviathanAIActive = true;
        gv_humanPlayers -= 1;
        TriggerEnable(gt_RandomizeSwarmConflictTyranids, true);
    }

    if ((PlayerType(gv_itemJorgumandr) == c_playerTypeComputer)) {
        gv_jorgumandrAIActive = true;
        gv_humanPlayers -= 1;
        TriggerEnable(gt_RandomizeSwarmConflictTyranids, true);
    }

    if ((PlayerType(gv_itemKraken) == c_playerTypeComputer)) {
        gv_krakenAIActive = true;
        gv_humanPlayers -= 1;
        TriggerEnable(gt_RandomizeSwarmConflictTyranids, true);
    }

    if ((PlayerType(gv_itemWarringStates) == c_playerTypeComputer)) {
        gv_warringStatesAIActive = true;
        gv_humanPlayers -= 1;
    }

    return true;
}

