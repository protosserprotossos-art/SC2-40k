//--------------------------------------------------------------------------------------------------
// Trigger: Tyranid War
//--------------------------------------------------------------------------------------------------
bool gt_TyranidWar_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGetOwner(EventUnit()) == gv_itemLeviathan) && (EventUnitAbility() == AbilityCommand("SinkingOfTheKraken", 0)) && (gv_krakenLeviathanAtWar == false)) {
        gv_tyranidFullTeam = false;
        gv_krakenLeviathanAtWar = true;
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "SinkingOfTheKraken", 1);
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/954C7C25"));
        gf_IncreaseDevouringHunger(UnitFromId(1775627665));
        gf_IncreaseDevouringHunger(UnitFromId(1775627665));
        Wait(10.0, c_timeGame);
        libNtve_gf_SetAlliance(gv_itemLeviathan, gv_itemKraken, libNtve_ge_AllianceSetting_Enemy);
    }
    else if ((UnitGetOwner(EventUnit()) == gv_itemJorgumandr) && (EventUnitAbility() == AbilityCommand("SinkingOfTheKraken", 0)) && (gv_krakenJorgumandrAtWar == false)) {
        gv_tyranidFullTeam = false;
        gv_krakenJorgumandrAtWar = true;
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "SinkingOfTheKraken", 1);
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/A6325BAF"));
        gf_IncreaseDevouringHunger(UnitFromId(60074446));
        gf_IncreaseDevouringHunger(UnitFromId(60074446));
        Wait(10.0, c_timeGame);
        libNtve_gf_SetAlliance(gv_itemJorgumandr, gv_itemKraken, libNtve_ge_AllianceSetting_Enemy);
    }
    if ((UnitGetOwner(EventUnit()) == gv_itemLeviathan) && (EventUnitAbility() == AbilityCommand("ScuttlingofJorgumandr", 0)) && (gv_leviathanJorgumandrAtWar == false)) {
        gv_tyranidFullTeam = false;
        gv_leviathanJorgumandrAtWar = true;
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "ScuttlingofJormungandr", 1);
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/ECE8676F"));
        gf_IncreaseDevouringHunger(UnitFromId(1775627665));
        gf_IncreaseDevouringHunger(UnitFromId(1775627665));
        Wait(10.0, c_timeGame);
        libNtve_gf_SetAlliance(gv_itemLeviathan, gv_itemJorgumandr, libNtve_ge_AllianceSetting_Enemy);
    }
    else if ((UnitGetOwner(EventUnit()) == gv_itemKraken) && (EventUnitAbility() == AbilityCommand("ScuttlingofJorgumandr", 0)) && (gv_krakenJorgumandrAtWar == false)) {
        gv_tyranidFullTeam = false;
        gv_krakenJorgumandrAtWar = true;
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "ScuttlingofJormungandr", 1);
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/9D46DD4C"));
        gf_IncreaseDevouringHunger(UnitFromId(149392864));
        gf_IncreaseDevouringHunger(UnitFromId(149392864));
        Wait(10.0, c_timeGame);
        libNtve_gf_SetAlliance(gv_itemKraken, gv_itemJorgumandr, libNtve_ge_AllianceSetting_Enemy);
    }
    if ((UnitGetOwner(EventUnit()) == gv_itemJorgumandr) && (EventUnitAbility() == AbilityCommand("DrowningoftheLeviathan", 0)) && (gv_leviathanJorgumandrAtWar == false)) {
        gv_tyranidFullTeam = false;
        gv_leviathanJorgumandrAtWar = true;
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "DrowningoftheLeviathan", 1);
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/8078A5B8"));
        gf_IncreaseDevouringHunger(UnitFromId(60074446));
        gf_IncreaseDevouringHunger(UnitFromId(60074446));
        Wait(10.0, c_timeGame);
        libNtve_gf_SetAlliance(gv_itemLeviathan, gv_itemJorgumandr, libNtve_ge_AllianceSetting_Enemy);
    }
    else if ((UnitGetOwner(EventUnit()) == gv_itemKraken) && (EventUnitAbility() == AbilityCommand("DrowningoftheLeviathan", 0)) && (gv_krakenLeviathanAtWar == false)) {
        gv_tyranidFullTeam = false;
        gv_krakenLeviathanAtWar = true;
        libNtve_gf_SetUpgradeLevelForPlayer(EventPlayer(), "DrowningoftheLeviathan", 1);
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/917B1E98"));
        gf_IncreaseDevouringHunger(UnitFromId(149392864));
        gf_IncreaseDevouringHunger(UnitFromId(149392864));
        Wait(10.0, c_timeGame);
        libNtve_gf_SetAlliance(gv_itemKraken, gv_itemLeviathan, libNtve_ge_AllianceSetting_Enemy);
    }
    return true;
}

