//--------------------------------------------------------------------------------------------------
bool gt_Kick_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_index;

    // Automatic Variable Declarations
    const int auto125A0D78_ae = 16;
    const int auto125A0D78_ai = 1;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    lv_index = 0;
    for ( ; ( (auto125A0D78_ai >= 0 && lv_index <= auto125A0D78_ae) || (auto125A0D78_ai < 0 && lv_index >= auto125A0D78_ae) ) ; lv_index += auto125A0D78_ai ) {
        if (((gf_BlacklistedPlayer(lv_index) == true) || (gf_WatchlistedPlayer(lv_index) == true))) {
            Wait(0.2, c_timeGame);
            KickFromGame(PlayerGroupSingle(lv_index));
        }

    }
    return true;
}

