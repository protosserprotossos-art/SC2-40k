//--------------------------------------------------------------------------------------------------
bool gt_FallenAngelsDestroyBeacons_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_index;

    // Automatic Variable Declarations
    const int auto18B1294D_ae = 7;
    const int auto18B1294D_ai = 1;

    // Variable Initialization
    lv_index = 1;

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(gt_FallenAngels, false);
    lv_index = 1;
    for ( ; ( (auto18B1294D_ai >= 0 && lv_index <= auto18B1294D_ae) || (auto18B1294D_ai < 0 && lv_index >= auto18B1294D_ae) ) ; lv_index += auto18B1294D_ai ) {
        if ((gv_fallenAngelsBeaconActivated[lv_index] == false) && (UnitIsAlive(gv_fallenAngelsBeacon[lv_index]) == true)) {
            UnitKill(gv_fallenAngelsBeacon[lv_index]);
        }

    }
    Wait(300.0, c_timeGame);
    TriggerExecute(gt_FallenAngelsBeaconSpawn, true, false);
    return true;
}

