//--------------------------------------------------------------------------------------------------
// Trigger: InitialResources/supply
//--------------------------------------------------------------------------------------------------
bool gt_InitialResourcessupply_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup auto69E3556D_g;
    int auto69E3556D_var;
    playergroup auto3F100F42_g;
    int auto3F100F42_var;

    // Actions
    if (!runActions) {
        return true;
    }

    auto69E3556D_g = gv_tyranids;
    auto69E3556D_var = -1;
    while (true) {
        auto69E3556D_var = PlayerGroupNextPlayer(auto69E3556D_g, auto69E3556D_var);
        if (auto69E3556D_var < 0) { break; }
        PlayerModifyPropertyInt(auto69E3556D_var, c_playerPropMinerals, c_playerPropOperSetTo, 0);
        PlayerModifyPropertyInt(auto69E3556D_var, c_playerPropVespene, c_playerPropOperSetTo, 1);
        PlayerModifyPropertyInt(auto69E3556D_var, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 500);
        PlayerModifyPropertyInt(auto69E3556D_var, c_playerPropSuppliesMade, c_playerPropOperAdd, gv_supplyCountJorgumandr);
    }
    auto3F100F42_g = gv_triumColation;
    auto3F100F42_var = -1;
    while (true) {
        auto3F100F42_var = PlayerGroupNextPlayer(auto3F100F42_g, auto3F100F42_var);
        if (auto3F100F42_var < 0) { break; }
        PlayerModifyPropertyInt(auto3F100F42_var, c_playerPropMinerals, c_playerPropOperSetTo, 0);
        PlayerModifyPropertyInt(auto3F100F42_var, c_playerPropVespene, c_playerPropOperSetTo, 1);
        PlayerModifyPropertyInt(auto3F100F42_var, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 500);
        PlayerModifyPropertyInt(gv_itemTau, c_playerPropTerrazine, c_playerPropOperSetTo, 1);
    }
    PlayerModifyPropertyInt(gv_itemHighlord, c_playerPropSuppliesMade, c_playerPropOperAdd, gv_supplyCountHighlords);
    PlayerModifyPropertyInt(gv_itemLion, c_playerPropSuppliesMade, c_playerPropOperAdd, gv_supplyCountLion);
    PlayerModifyPropertyInt(gv_itemRoboute, c_playerPropSuppliesMade, c_playerPropOperAdd, gv_supplyCountRoboute);
    PlayerModifyPropertyInt(gv_itemTau, c_playerPropSuppliesMade, c_playerPropOperAdd, gv_supplyCountTau);
    PlayerModifyPropertyInt(gv_itemNecrons, c_playerPropSuppliesMade, c_playerPropOperAdd, gv_supplyCountNecrons);
    PlayerModifyPropertyInt(gv_itemWarringStates, c_playerPropMinerals, c_playerPropOperSetTo, 0);
    PlayerModifyPropertyInt(gv_itemWarringStates, c_playerPropVespene, c_playerPropOperSetTo, 1);
    PlayerModifyPropertyInt(gv_itemWarringStates, c_playerPropTerrazine, c_playerPropOperSetTo, 1);
    PlayerModifyPropertyInt(gv_itemWarringStates, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 500);
    PlayerModifyPropertyInt(gv_itemWarringStates, c_playerPropSuppliesMade, c_playerPropOperAdd, gv_supplyCountWarringStates);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_InitialResourcessupply_Init () {
    gt_InitialResourcessupply = TriggerCreate("gt_InitialResourcessupply_Func");
    TriggerAddEventMapInit(gt_InitialResourcessupply);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Initial Alliances
//--------------------------------------------------------------------------------------------------
bool gt_InitialAlliances_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_SetPlayerGroupAlliance(gv_triumColation, libNtve_ge_AllianceSetting_Ally);
    libNtve_gf_SetPlayerGroupAlliance(gv_tyranids, libNtve_ge_AllianceSetting_AllyWithSharedVision);
    libNtve_gf_SetAllianceBetweenTwoPlayerGroups(gv_triumColation, gv_tyranids, libNtve_ge_AllianceSetting_Enemy);
    libNtve_gf_SetAllianceBetweenTwoPlayerGroups(gv_tyranids, gv_triumColation, libNtve_ge_AllianceSetting_Enemy);
    libNtve_gf_SetAllianceBetweenTwoPlayerGroups(gv_tyranids, PlayerGroupSingle(gv_itemWarringStates), libNtve_ge_AllianceSetting_Enemy);
    libNtve_gf_SetAllianceBetweenTwoPlayerGroups(gv_triumColation, PlayerGroupSingle(gv_itemWarringStates), libNtve_ge_AllianceSetting_Enemy);
    libNtve_gf_SetAllianceBetweenTwoPlayerGroups(PlayerGroupSingle(gv_itemWarringStates), gv_tyranids, libNtve_ge_AllianceSetting_Enemy);
    libNtve_gf_SetAllianceBetweenTwoPlayerGroups(PlayerGroupSingle(gv_itemWarringStates), gv_triumColation, libNtve_ge_AllianceSetting_Enemy);
    if ((gv_robouteHighlordsAtWar == true)) {
        libNtve_gf_SetAlliance(gv_itemRoboute, gv_itemHighlord, libNtve_ge_AllianceSetting_Enemy);
    }

    if ((gv_robouteLionAtWar == true)) {
        libNtve_gf_SetAlliance(gv_itemRoboute, gv_itemLion, libNtve_ge_AllianceSetting_Enemy);
    }

    if ((gv_highlordsLionAtWar == true)) {
        libNtve_gf_SetAlliance(gv_itemHighlord, gv_itemLion, libNtve_ge_AllianceSetting_Enemy);
    }

    if ((gv_imperiumTauAtWar == true)) {
        libNtve_gf_SetAlliance(gv_itemHighlord, gv_itemTau, libNtve_ge_AllianceSetting_Enemy);
        libNtve_gf_SetAlliance(gv_itemLion, gv_itemTau, libNtve_ge_AllianceSetting_Enemy);
        libNtve_gf_SetAlliance(gv_itemRoboute, gv_itemTau, libNtve_ge_AllianceSetting_Enemy);
    }

    if ((gv_imperiumNecronsAtWar == true)) {
        libNtve_gf_SetAlliance(gv_itemHighlord, gv_itemNecrons, libNtve_ge_AllianceSetting_Enemy);
        libNtve_gf_SetAlliance(gv_itemLion, gv_itemNecrons, libNtve_ge_AllianceSetting_Enemy);
        libNtve_gf_SetAlliance(gv_itemRoboute, gv_itemNecrons, libNtve_ge_AllianceSetting_Enemy);
    }

    if ((gv_tauNecronsAtWar == true)) {
        libNtve_gf_SetAlliance(gv_itemTau, gv_itemNecrons, libNtve_ge_AllianceSetting_Enemy);
    }

    if ((gv_krakenLeviathanAtWar == true)) {
        libNtve_gf_SetAlliance(gv_itemKraken, gv_itemLeviathan, libNtve_ge_AllianceSetting_Enemy);
    }

    if ((gv_krakenJorgumandrAtWar == true)) {
        libNtve_gf_SetAlliance(gv_itemKraken, gv_itemJorgumandr, libNtve_ge_AllianceSetting_Enemy);
    }

    if ((gv_leviathanJorgumandrAtWar == true)) {
        libNtve_gf_SetAlliance(gv_itemLeviathan, gv_itemJorgumandr, libNtve_ge_AllianceSetting_Enemy);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_InitialAlliances_Init () {
    gt_InitialAlliances = TriggerCreate("gt_InitialAlliances_Func");
    TriggerAddEventMapInit(gt_InitialAlliances);
}

