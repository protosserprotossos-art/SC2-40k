void gf_ReduceDurability (unit lp_spawner) {
    // Variable Declarations
    int lv_currentDurability;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_currentDurability = UnitGetAttributePoint(lp_spawner, "Durability", true);
    lv_currentDurability -= 1;
    UnitSetAttributePoint(lp_spawner, "Durability", true, lv_currentDurability);
}

bool gf_DestroySpawner (unit lp_spawner) {
    // Variable Declarations
    int lv_currentDurability;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    if ((UnitGetAttributePoint(lp_spawner, "Durability", true) <= 0)) {
        gf_RemoveSpawnersfromUnitGroup(lp_spawner);
        UnitKill(lp_spawner);
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, ((StringExternal("Param/Value/E568B0BA") + TextWithColor(UnitGetName(lp_spawner), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(EventPlayer(), false)))) + (StringExternal("Param/Value/E9DE92A2") + TextWithColor(UnitGetName(libNtve_gf_KillingUnit()), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(UnitGetOwner(libNtve_gf_KillingUnit()), false))))));
        return true;
    }
    else {
        return false;
    }
}

