void gt_NecronCtanShardsCreate_Init () {
    gt_NecronCtanShardsCreate = TriggerCreate("gt_NecronCtanShardsCreate_Func");
    TriggerAddEventTimeElapsed(gt_NecronCtanShardsCreate, 600.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Necron C'tan Shards Beacons
//--------------------------------------------------------------------------------------------------
bool gt_NecronCtanShardsBeacons_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_integer;

    // Automatic Variable Declarations
    const int auto9DD34ECF_ae = 4;
    const int auto9DD34ECF_ai = 1;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == gv_itemNecrons))) {
            return false;
        }

        if (!((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeHeroic) == true))) {
            return false;
        }

        if (!(((UnitGetType(EventUnit()) == "ImotekhTheStomlord") || (UnitGetType(EventUnit()) == "ZeratulVoidAiur01") || (UnitGetType(EventUnit()) == "TrazynTheInfinite")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_integer = 1;
    for ( ; ( (auto9DD34ECF_ai >= 0 && lv_integer <= auto9DD34ECF_ae) || (auto9DD34ECF_ai < 0 && lv_integer >= auto9DD34ECF_ae) ) ; lv_integer += auto9DD34ECF_ai ) {
        if ((EventUnitRegion() == gv_ctanshardsRegionsarray[lv_integer]) && (gv_ctanShardActvatedArrays[lv_integer] == true)) {
            gv_ctanShardActvatedArrays[lv_integer] = false;
            UnitKill(gv_ctanShardBeaconsArray[lv_integer]);
            gv_ctanShardsCompleted += 1;
            TriggerExecute(gt_NecronCtanShardSpawn, true, false);
        }

    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_NecronCtanShardsBeacons_Init () {
    gt_NecronCtanShardsBeacons = TriggerCreate("gt_NecronCtanShardsBeacons_Func");
    TriggerEnable(gt_NecronCtanShardsBeacons, false);
    TriggerAddEventUnitRegion(gt_NecronCtanShardsBeacons, null, RegionFromId(71), true);
    TriggerAddEventUnitRegion(gt_NecronCtanShardsBeacons, null, RegionFromId(72), true);
    TriggerAddEventUnitRegion(gt_NecronCtanShardsBeacons, null, RegionFromId(73), true);
    TriggerAddEventUnitRegion(gt_NecronCtanShardsBeacons, null, RegionFromId(74), true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Necron C'tan Shard Spawn
//--------------------------------------------------------------------------------------------------
bool gt_NecronCtanShardSpawn_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_ctanShardsCompleted == 1)) {
        UIDisplayMessage(PlayerGroupSingle(gv_itemNecrons), c_messageAreaSubtitle, StringExternal("Param/Value/6789CDC3"));
    }
    else if ((gv_ctanShardsCompleted == 2)) {
        UIDisplayMessage(PlayerGroupSingle(gv_itemNecrons), c_messageAreaSubtitle, StringExternal("Param/Value/FAA3CD58"));
    }
    else if ((gv_ctanShardsCompleted == 3)) {
        UIDisplayMessage(PlayerGroupSingle(gv_itemNecrons), c_messageAreaSubtitle, StringExternal("Param/Value/A299D419"));
    }
    else if ((gv_ctanShardsCompleted == 4)) {
        UIDisplayMessage(PlayerGroupSingle(gv_itemNecrons), c_messageAreaSubtitle, StringExternal("Param/Value/6765FD09"));
    }
    else if ((gv_ctanShardsCompleted == 5)) {
        UIDisplayMessage(PlayerGroupSingle(gv_itemNecrons), c_messageAreaSubtitle, StringExternal("Param/Value/DA703974"));
    }
    else if ((gv_ctanShardsCompleted == 6) && (gv_ctanEventCompleted == false)) {
        gv_ctanEventCompleted = true;
        TriggerEnable(gt_NecronCtanShardsBeacons, false);
        UIDisplayMessage(PlayerGroupSingle(gv_itemNecrons), c_messageAreaSubtitle, StringExternal("Param/Value/506B9F6D"));
        TriggerEnable(TriggerGetCurrent(), false);
        if ((UnitIsAlive(gv_trazynTheInfinite) == true)) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "HybridDominatorVoid", c_unitCreateIgnorePlacement, UnitGetOwner(gv_trazynTheInfinite), UnitGetPosition(gv_trazynTheInfinite));
            gv_ctan = UnitLastCreated();
        }

        if ((UnitIsAlive(gv_imotekhTheStormlord) == true)) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "HybridDominatorVoid", c_unitCreateIgnorePlacement, UnitGetOwner(gv_imotekhTheStormlord), UnitGetPosition(gv_imotekhTheStormlord));
            gv_ctan = UnitLastCreated();
        }

        if ((UnitIsAlive(UnitFromId(1244147445)) == true)) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "HybridDominatorVoid", c_unitCreateIgnorePlacement, UnitGetOwner(UnitFromId(1244147445)), UnitGetPosition(UnitFromId(1244147445)));
            gv_ctan = UnitLastCreated();
        }

    }
    return true;
}

