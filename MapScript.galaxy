//--------------------------------------------------------------------------------------------------
// Trigger: Constantin Valdor Spawn
//--------------------------------------------------------------------------------------------------
bool gt_ConstantinValdorSpawn_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_constantinValdorCluesCompleted == 1)) {
        UIDisplayMessage(PlayerGroupSingle(gv_itemRoboute), c_messageAreaSubtitle, StringExternal("Param/Value/0B67FBBF"));
    }
    else if ((gv_constantinValdorCluesCompleted == 2)) {
        UIDisplayMessage(PlayerGroupSingle(gv_itemRoboute), c_messageAreaSubtitle, StringExternal("Param/Value/4698CD71"));
    }
    else if ((gv_constantinValdorCluesCompleted == 3)) {
        UIDisplayMessage(PlayerGroupSingle(gv_itemRoboute), c_messageAreaSubtitle, StringExternal("Param/Value/1FC3E246"));
    }
    else if ((gv_constantinValdorCluesCompleted == 4)) {
        TriggerEnable(gt_ConstantinValdorBeaconActivations, false);
        TriggerEnable(TriggerGetCurrent(), false);
        UIDisplayMessage(PlayerGroupSingle(gv_itemRoboute), c_messageAreaSubtitle, StringExternal("Param/Value/74DEB89C"));
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "ConstantinValdor", 0, UnitGetOwner(gv_robouteGuiliman), UnitGetPosition(gv_robouteGuiliman));
    }
    return true;
}

