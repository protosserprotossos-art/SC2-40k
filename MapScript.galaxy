    gt_RobouteHighlordWar = TriggerCreate("gt_RobouteHighlordWar_Func");
    TriggerAddEventUnitAbility(gt_RobouteHighlordWar, null, AbilityCommand("TheAvengingSonsWrath", 0), c_unitAbilStageComplete, false);
