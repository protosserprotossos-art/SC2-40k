        UnitKill(gv_fallenAngelsBeacon[5]);
        gf_Createunitnosupply(5, "SpaceMarineTerminator", UnitFromId(1799516799), PointFromId(669849953));
        gf_Createunitnosupply(5, "Marine", UnitFromId(1799516799), PointFromId(669849953));
        UIDisplayMessage(PlayerGroupSingle(gv_itemLion), c_messageAreaSubtitle, StringExternal("Param/Value/10C6CABD"));
        TriggerExecute(gt_FallenAngelsDestroyBeacons, true, false);
    }

    if ((EventUnitRegion() == RegionFromId(81)) && (gv_fallenAngelsBeaconActivated[6] == false)) {
        gv_fallenAngelsbeaconscompleted += 1;
        gv_fallenAngelsBeaconActivated[6] = true;
